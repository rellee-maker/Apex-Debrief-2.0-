    ctx.strokeStyle = light ? '#7c3aed' : '#c084fc'; ctx.lineWidth = 2; ctx.beginPath();
    ctx.moveTo(gx - g.hy*L, gy - g.hx*L); ctx.lineTo(gx + g.hy*L, gy + g.hx*L); ctx.stroke();
    if (opts.gateLabels !== false) { ctx.fillStyle = light ? '#4c1d95' : '#e9d5ff'; ctx.font = 'bold 10px JetBrains Mono, monospace'; ctx.fillText(String(i+1), gx + 6 + g.hy*4, gy - 6 + g.hx*4); }
  });
