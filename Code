function speedColor(ratio) {
  // red (slow) → amber → green (fast)
  const stops = [[0, [239,68,68]], [0.5, [245,158,11]], [1, [16,185,129]]];
  ratio = Math.max(0, Math.min(1, ratio));
  for (let i = 1; i < stops.length; i++) if (ratio <= stops[i][0]) {
    const [p0, c0] = stops[i-1], [p1, c1] = stops[i], f = (ratio-p0)/(p1-p0);
    return `rgb(${c0.map((v, k) => Math.round(v + f*(c1[k]-v))).join(',')})`;
  }
  return 'rgb(16,185,129)';
}
function drawMap(canvas, s, lap, opts = {}) {
