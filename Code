  const k = (label, val, sub, cls) => `<div class="panel p-4 text-center"><div class="text-[10px] font-mono text-slate-500 kicker">${label}</div><div class="font-display font-bold text-3xl ${cls}">${val}</div><div class="text-[10px] font-mono text-slate-500">${sub}</div></div>`;
  $('input-kpis').innerHTML = [
    k('FULL THROTTLE', tps ? mean('full').toFixed(1)+'%' : '—', 'time at ≥90% TPS', 'text-emerald-400'),
    k('AVG THROTTLE', tps ? mean('avgTps').toFixed(1)+'%' : '—', 'flying laps', 'text-blue-400'),
    k('COASTING', tps ? mean('coast').toFixed(2)+'s' : '—', 'per lap, off both pedals', 'text-amber-400'),
