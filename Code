  barChart('ch-mech-trend', laps.map(l => `L${l.num}`), [{ data: vals, backgroundColor: laps.map(l => l.type === 'flying' ? '#3b82f6' : '#475569') }],
    { y: { beginAtZero: false, title: { display: true, text: `${m.label} (${m.unit})` } }, tooltip: { label: c => `${fmtNum(c.parsed.y, 2)} ${m.unit} · ${TYPE_STYLE[laps[c.dataIndex].type][0].toLowerCase()}` } });
}

// =====================================================================
// AUDIT
// =====================================================================
function renderAudit(s) {
  const ST = { ok: ['OK','bg-emerald-500/10 text-emerald-300 border-emerald-500/30'], info: ['NOTE','bg-blue-500/10 text-blue-300 border-blue-500/30'], suspect: ['CHECK SCALING','bg-amber-500/10 text-amber-300 border-amber-500/30'], dead: ['NO SIGNAL','bg-red-500/10 text-red-300 border-red-500/30'] };
  const counts = { ok: 0, info: 0, suspect: 0, dead: 0 }; s.channels.forEach(c => counts[c.status]++);
  $('audit-summary').innerHTML = Object.entries(counts).filter(([,v]) => v).map(([k, v]) => `<span class="px-2 py-1 rounded border ${ST[k][1]}">${v} ${ST[k][0]}</span>`).join('');
  $('audit-table').innerHTML = `<thead><tr class="bg-racing-cardBg border-b border-racing-border text-slate-400"><th class="p-2">#</th><th class="p-2">CHANNEL</th><th class="p-2">FILE UNIT → SHOWN</th><th class="p-2 text-right">MIN</th><th class="p-2 text-right">AVG</th><th class="p-2 text-right">MAX</th><th class="p-2">USED AS</th><th class="p-2">STATUS</th><th class="p-2">SCALE</th></tr></thead><tbody class="divide-y divide-racing-border/50">` +
    s.channels.map((c, i) => `<tr class="align-top hover:bg-slate-800/30">
      <td class="p-2 text-slate-500">${i+1}</td>
      <td class="p-2"><div class="font-bold text-slate-200">${esc(c.name)}</div>${c.issues.map(x => `<div class="text-[10px] mt-0.5 ${x.level === 'suspect' ? 'text-amber-300' : x.level === 'dead' ? 'text-red-300' : 'text-slate-400'} max-w-md whitespace-normal">${esc(x.text)}</div>`).join('')}</td>
      <td class="p-2 text-amber-300 whitespace-nowrap">${esc(c.rawUnit || '—')} → ${esc(c.unit)}</td>
      <td class="p-2 text-right text-slate-300">${fmtNum(c.stats.min)}</td><td class="p-2 text-right text-blue-300">${fmtNum(c.stats.avg)}</td><td class="p-2 text-right text-slate-300">${fmtNum(c.stats.max)}</td>
      <td class="p-2 text-purple-300">${c.logical && c.logical !== 'lapcol' ? esc(c.logical) : '<span class="text-slate-600">—</span>'}</td>
      <td class="p-2"><span class="px-1.5 py-0.5 rounded text-[9px] border whitespace-nowrap ${ST[c.status][1]}">${ST[c.status][0]}</span></td>
      <td class="p-2 whitespace-nowrap"><input type="number" step="any" value="${c.cal.scale}" data-ch="${i}" class="cal-input w-20 text-xs">${c.cal.scale !== 1 ? ` <button data-reset="${i}" class="text-slate-400 hover:text-white" title="Reset"><i class="fa-solid fa-rotate-left"></i></button>` : ''}</td>
    </tr>`).join('') + '</tbody>';
  $('audit-table').querySelectorAll('.cal-input').forEach(inp => inp.addEventListener('change', () => setCal(s, +inp.dataset.ch, Number(inp.value))));
  $('audit-table').querySelectorAll('[data-reset]').forEach(b => b.addEventListener('click', () => setCal(s, +b.dataset.reset, 1)));
}
function setCal(s, idx, scale) {
  if (!isNum(scale) || scale === 0) return;
  const ch = s.channels[idx];
  applyCal(ch, { scale, offset: 0 }); saveCal(s.vehicle, ch.name, ch.cal);
