  ctx.lineWidth = 3.5;
  for (let i = lap.iStart+1; i <= lap.iEnd; i++) {
    if (!isNum(X[i]) || !isNum(X[i-1])) continue;
    let col = '#60a5fa';
    if (opts.colorFn) col = opts.colorFn(s.lapDist[i]);
