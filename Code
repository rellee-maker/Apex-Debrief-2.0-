  const ic = { ok: 'border-emerald-500/40', amber: 'border-amber-500/40', scale: 'border-slate-500', dead: 'border-slate-700', info: 'border-blue-500/40' };
  $('mech-notes').innerHTML = N.map(([c, t]) => `<div class="p-2.5 rounded-lg bg-slate-900 border-l-4 ${ic[c]}">${esc(t)}</div>`).join('');

