  if (!isNum(x0)) return;
  const pad = 28, sc = Math.min((W-2*pad)/((x1-x0)||1), (H-2*pad)/((y1-y0)||1));
  const ox = (W - (x1-x0)*sc)/2, oy = (H - (y1-y0)*sc)/2;
