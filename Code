// TELEMETRY
// =====================================================================
function lapByNum(s, n) { return s.laps.find(l => l.num === n) || null; }
function lapOptions(s, includeNone) {
  const opts = s.laps.filter(l => l.type !== 'partial').map(l => `<option value="${l.num}">L${l.num} — ${fmtLap(l.seconds)}${l.isBest ? ' (best)' : l.type !== 'flying' ? ` (${TYPE_STYLE[l.type][0].toLowerCase()})` : ''}</option>`);
  return (includeNone ? '<option value="">None</option>' : '') + opts.join('');
}
$('sel-ref').addEventListener('change', e => { S.ref = +e.target.value; renderTelemetry(sess()); });
$('sel-cmp').addEventListener('change', e => { S.cmp = e.target.value ? +e.target.value : null; renderTelemetry(sess()); });
$('btn-swap').addEventListener('click', () => { if (!S.cmp) return; [S.ref, S.cmp] = [S.cmp, S.ref]; renderTelemetry(sess()); });
$('scrubber').addEventListener('input', e => { if (S.grid) setCursor(S.grid[S.grid.length-1] * e.target.value/1000, true); });
$('sel-explore').addEventListener('change', () => renderExplorer(sess()));
$('sel-explore-mode').addEventListener('change', () => renderExplorer(sess()));

function buildSeries(s) {
  const ref = lapByNum(s, S.ref) || bestLap(s), cmp = S.cmp ? lapByNum(s, S.cmp) : null;
  const grid = lapGrid(ref, 2), scale = cmp ? cmp.length/ref.length : 1;
  const get = (lap, arr, sc, tm) => arr ? lapSeries(s, lap, arr, grid, sc, tm) : null;
  const L = k => chData(s, k);
  const spdArr = L('speed') || L('wspeed');
  const series = { ref, cmp, grid, r: {}, c: {} };
  const keys = { speed: spdArr, tps: L('tps'), brake: s.brakePct, rpm: L('rpm'), gear: L('gear'), steer: L('steer'), latg: L('latg') };
  for (const [k, arr] of Object.entries(keys)) { series.r[k] = get(ref, arr, 1); if (cmp) series.c[k] = get(cmp, arr, scale); }
  series.r.time = get(ref, s.time, 1, true);
  if (cmp) {
    series.c.time = get(cmp, s.time, scale, true);
    series.delta = new Float64Array(grid.length);
    for (let i=0;i<grid.length;i++) series.delta[i] = series.c.time[i] - series.r.time[i];
  }
  return series;
}

function renderTelemetry(s) {
  if (!lapByNum(s, S.ref)) resetLapSelection();
  $('sel-ref').innerHTML = lapOptions(s, false); $('sel-ref').value = S.ref;
  $('sel-cmp').innerHTML = lapOptions(s, true); $('sel-cmp').value = S.cmp ?? '';
  const ser = S.series = buildSeries(s); S.grid = ser.grid;
  const { grid, r, c, ref, cmp } = ser;
  const xMax = grid[grid.length-1];
  $('lbl-lapdelta').innerHTML = cmp ? `<span class="text-slate-400">L${cmp.num} vs L${ref.num}:</span> <span class="${cmp.seconds > ref.seconds ? 'text-red-400' : 'text-emerald-400'} font-bold">${fmtDelta(cmp.seconds - ref.seconds)}s</span>` : '';
  const D = (data, color, label, extra = {}) => ({ data: xy(grid, data), borderColor: color, label, ...extra });
  const dash = { borderDash: [4, 3] };
  const opt = { xMin: 0, xMax, cursor: true, legend: false };

  lineChart('ch-speed', [ r.speed && D(r.speed, '#60a5fa', `L${ref.num}`), cmp && c.speed && D(c.speed, '#f87171', `L${cmp.num}`, dash) ].filter(Boolean), { ...opt, legend: true });
  if (ser.delta) {
    lineChart('ch-delta', [ D(ser.delta, '#f59e0b', 'Δ', { fill: { target: 'origin', above: 'rgba(239,68,68,.18)', below: 'rgba(16,185,129,.18)' } }) ], opt);
  } else { lineChart('ch-delta', [], opt); }
  lineChart('ch-pedals', [ r.tps && D(r.tps, '#f59e0b', 'TPS'), r.brake && D(r.brake, '#ef4444', 'Brake %'), cmp && c.tps && D(c.tps, '#fcd34d', 'TPS cmp', dash), cmp && c.brake && D(c.brake, '#fca5a5', 'Brake cmp', dash) ].filter(Boolean), { ...opt, yMin: 0, yMax: 105 });
  lineChart('ch-rpm', [ r.rpm && D(r.rpm, '#10b981', 'RPM'), cmp && c.rpm && D(c.rpm, '#6ee7b7', 'RPM cmp', dash), r.gear && D(r.gear, '#a78bfa', 'Gear', { yAxisID: 'y2', stepped: true }) ].filter(Boolean), { ...opt, y2: { min: 0, max: 6, ticks: { stepSize: 1 } } });
  lineChart('ch-steer', [ r.steer && D(r.steer, '#2dd4bf', 'Steer'), cmp && c.steer && D(c.steer, '#99f6e4', 'Steer cmp', dash), r.latg && D(r.latg, '#ec4899', 'Lat G', { yAxisID: 'y2' }) ].filter(Boolean), { ...opt, y2: { min: -2.2, max: 2.2 } });

  // Gauges
  const spdMax = Math.max(...s.laps.map(l => l.topSpeed).filter(isNum), 1), rpmMax = chData(s,'rpm') ? stats(chData(s,'rpm')).max : 1;
  S.gaugeMax = { speed: spdMax, rpm: rpmMax };

  // Sector compare
  if (s.sectorCount && cmp) {
    const rows = Array.from({ length: s.sectorCount }, (_, i) => {
      const a = ref.sectors[i], b = cmp.sectors[i], d = b - a;
      return `<tr class="border-b border-racing-border/40"><td class="py-1 pr-2 text-slate-400">S${i+1}</td><td class="py-1 pr-2 text-right">${fmtNum(a,3)}</td><td class="py-1 pr-2 text-right">${fmtNum(b,3)}</td><td class="py-1 text-right font-bold ${d > 0.02 ? 'text-red-400' : d < -0.02 ? 'text-emerald-400' : 'text-slate-400'}">${fmtDelta(d)}</td></tr>`;
