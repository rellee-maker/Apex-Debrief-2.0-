  // cursor
  if (opts.cursorD != null) {
    const D = s.lapDist; let j = lap.iStart; while (j < lap.iEnd && D[j] < opts.cursorD) j++;
    if (isNum(X[j])) { ctx.fillStyle = '#3b82f6'; ctx.strokeStyle = '#fff'; ctx.lineWidth = 2; ctx.beginPath(); ctx.arc(tx(X[j]), ty(Y[j]), 7, 0, Math.PI*2); ctx.fill(); ctx.stroke(); }
  }
  if (opts.label) { ctx.fillStyle = 'rgba(15,23,42,.8)'; ctx.fillRect(0, 0, W, 20); ctx.fillStyle = '#94a3b8'; ctx.font = '10px monospace'; ctx.fillText(opts.label, 8, 14); }
}
function drawTelemetryMap() {
  const s = sess(); if (!s || !S.series) return;
  const { ref, cmp, delta, grid } = S.series;
  let colorFn = null;
  if (cmp && delta) {
    // Color by where the compare lap gains/loses time (slope of delta over ~20 m)
    const step = grid[1]-grid[0], w = Math.max(1, Math.round(10/step));
    colorFn = d => {
      const i = Math.min(grid.length-1-w, Math.max(w, Math.round(d/step)));
      const slope = (delta[i+w] - delta[i-w]) / (2*w*step) * 100; // s per 100 m
      return slope > 0.06 ? (slope > 0.25 ? '#ef4444' : '#f97316') : slope < -0.06 ? (slope < -0.25 ? '#10b981' : '#6ee7b7') : '#64748b';
    };
    $('map-legend').innerHTML = `<span style="color:#ef4444">■</span> L${cmp.num} losing · <span style="color:#10b981">■</span> gaining`;
  } else $('map-legend').innerHTML = 'speed: <span style="color:#ef4444">■</span> slow → <span style="color:#10b981">■</span> fast';
  drawMap($('map-telemetry'), s, ref, { colorFn, cursorD: S.cursorD, gateLabels: true });
}
window.addEventListener('resize', () => { if (S.tab === 'telemetry') drawTelemetryMap(); if (S.tab === 'coaching' && sess()) drawMap($('map-coach'), sess(), bestLap(sess()), { label: `Best lap — L${bestLap(sess()).num} (${fmtLap(bestLap(sess()).seconds)})` }); });

