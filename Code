  H.push(['emerald', 'BEST LAP', `Lap ${best.num} — ${fmtLap(best.seconds)}${isNum(best.topSpeed) ? `, ${best.topSpeed.toFixed(1)} mph top speed` : ''}.`]);
  if (isNum(s.theo)) {
    const contrib = s.sectorBest.map((b, i) => ({ i, lap: b.lap, gain: best.sectors[i] - b.time })).filter(x => isNum(x.gain) && x.gain > 0.005).sort((a,b) => b.gain - a.gain).slice(0, 3);
    H.push(['purple', 'THEORETICAL', `Best sectors combined = ${fmtLap(s.theo)} (${fmtDelta(s.theo - best.seconds)}s). Biggest gaps in your best lap: ${contrib.map(c => `S${c.i+1} ${fmtDelta(-c.gain)}s (L${c.lap})`).join(', ') || '—'}.`]);
  }
  if (isNum(sd)) H.push(['blue', 'CONSISTENCY', `${flying.length} flying laps averaging ${fmtLap(avg)}, σ ±${sd.toFixed(3)}s; spread ${(Math.max(...flying.map(l=>l.seconds)) - best.seconds).toFixed(3)}s.`]);
  const slow = s.laps.filter(l => l.type === 'slow');
  if (slow.length) H.push(['amber', 'SLOW LAPS', `${slow.length} lap${slow.length>1?'s':''} over 105% (${slow.map(l => 'L'+l.num).join(', ')}) — caution, traffic or pit. Excluded from pace stats.`]);
  const warn = s.channels.filter(c => c.status === 'suspect');
  if (warn.length) H.push(['red', 'DATA QUALITY', `${warn.length} channel${warn.length>1?'s':''} look mis-scaled (${warn.map(c => c.name).join(', ')}). See Channel Audit.`]);
  const colors = { emerald: 'border-emerald-500 text-emerald-400', purple: 'border-purple-500 text-purple-400', blue: 'border-blue-500 text-blue-400', amber: 'border-amber-500 text-amber-400', red: 'border-red-500 text-red-400' };
  $('highlights').innerHTML = H.map(([c, t, x]) => `<div class="p-2.5 rounded bg-slate-900 border-l-4 ${colors[c].split(' ')[0]}"><span class="${colors[c].split(' ')[1]} font-bold">[${t}]</span> <span class="text-slate-300">${esc(x)}</span></div>`).join('');
}

