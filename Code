}
function renderSnapshot(s) {
  const flying = s.laps.filter(l => l.type === 'flying');
  const best = bestLap(s);
  const avg = flying.length ? flying.reduce((a,l) => a+l.seconds, 0)/flying.length : NaN;
  const sd = flying.length > 1 ? Math.sqrt(flying.reduce((a,l) => a+(l.seconds-avg)**2, 0)/flying.length) : NaN;
  const top = s.laps.reduce((m,l) => isNum(l.topSpeed) && l.topSpeed > m.v ? { v: l.topSpeed, lap: l.num } : m, { v: -Infinity, lap: null });
  const latg = chData(s,'latg'); const lg = latg ? stats(latg.map(Math.abs)) : null;
  $('kpi-row').innerHTML = [
    kpi('BEST LAP', fmtLap(best.seconds), `Lap ${best.num}`, 'text-emerald-400', 'border-emerald-500/40'),
    kpi('THEORETICAL BEST', fmtLap(s.theo), isNum(s.theo) ? `${fmtDelta(s.theo - best.seconds)}s vs best` : 'needs .amss splits', 'text-purple-400', 'border-purple-500/40'),
    kpi('AVG FLYING LAP', fmtLap(avg), isNum(sd) ? `σ ±${sd.toFixed(3)}s` : '—', 'text-blue-400'),
    kpi('LAPS', `${s.laps.length}`, `${flying.length} flying · ${s.laps.filter(l=>l.type==='slow').length} slow`),
    kpi('TOP SPEED', isNum(top.v) ? `${top.v.toFixed(1)}` : '—', top.lap ? `mph · Lap ${top.lap}` : 'mph', 'text-amber-400'),
    kpi('PEAK LAT G', lg ? lg.max.toFixed(2) : '—', esc(chObj(s,'latg')?.name || 'no channel'), 'text-pink-400'),
  ].join('');

  // Lap table
  const nS = s.sectorCount;
  const head = `<thead><tr class="bg-racing-cardBg border-b border-racing-border text-slate-400"><th class="p-2 sticky-col">LAP</th><th class="p-2">TIME</th><th class="p-2">Δ BEST</th><th class="p-2">TYPE</th><th class="p-2">TOP</th>${Array.from({length:nS}, (_,i) => `<th class="p-2 text-right" title="Gate ${i ? esc(s.gates ? s.gates[i-1].name : i) : 'S/F'} → ${i < nS-1 ? esc(s.gates ? s.gates[i].name : i+1) : 'S/F'}">S${i+1}</th>`).join('')}</tr></thead>`;
  const body = s.laps.map(l => {
    const [label, tcls, badge] = TYPE_STYLE[l.type];
    const sec = Array.from({length:nS}, (_,i) => {
      const v = l.sectors[i], b = s.sectorBest[i];
      const isB = b && isNum(v) && Math.abs(v - b.time) < 0.0005 && b.lap === l.num;
      return `<td class="p-2 text-right ${isB ? 'text-purple-300 font-bold bg-purple-500/15' : (l.type === 'flying' ? 'text-slate-300' : 'text-slate-500')}">${isNum(v) ? v.toFixed(2) : '—'}</td>`;
    }).join('');
    return `<tr data-lap="${l.num}" class="hover:bg-slate-800/60 cursor-pointer ${l.isBest ? 'bg-emerald-500/5' : ''}">
      <td class="p-2 font-bold sticky-col">L${l.num}</td>
      <td class="p-2 font-bold ${l.isBest ? 'text-emerald-400' : tcls}">${fmtLap(l.seconds)}</td>
      <td class="p-2 text-slate-400">${l.isBest ? 'BEST' : fmtDelta(l.seconds - s.bestSeconds)}</td>
      <td class="p-2"><span class="px-1.5 py-0.5 rounded text-[9px] border ${badge}">${label}</span></td>
      <td class="p-2 text-amber-400">${fmtNum(l.topSpeed, 1)}</td>${sec}</tr>`;
  }).join('');
  $('lap-table').innerHTML = head + `<tbody class="divide-y divide-racing-border/50">${body}</tbody>`;
  $('lap-table').querySelectorAll('tr[data-lap]').forEach(tr => tr.onclick = () => {
    const n = +tr.dataset.lap; if (n !== S.ref) S.cmp = n; switchTab('telemetry');
  });

  // Lap pace chart (flying laps)
  $('lbl-theo').innerText = fmtLap(s.theo);
  const lo = Math.floor(Math.min(s.bestSeconds, isNum(s.theo) ? s.theo : Infinity) - 0.5);
  barChart('chart-laps', flying.map(l => `L${l.num}`), [{ data: flying.map(l => l.seconds), backgroundColor: flying.map(l => l.isBest ? '#10b981' : '#3b82f6') }],
    { y: { min: lo, ticks: { callback: v => fmtLap(v) } }, tooltip: { label: c => fmtLap(c.parsed.y) },
      onClick: (e, els) => { if (els.length) { const l = flying[els[0].index]; if (l.num !== S.ref) S.cmp = l.num; switchTab('telemetry'); } } });

  // Sector opportunity
  $('sum-theo').innerText = fmtLap(s.theo);
  if (nS) {
    $('sector-empty').classList.add('hidden'); $('sector-loss-wrap').classList.remove('hidden');
    const losses = Array.from({length:nS}, (_,i) => {
      const v = flying.map(l => l.sectors[i]).filter(isNum); const b = s.sectorBest[i];
      return v.length && b ? v.reduce((a,x)=>a+x,0)/v.length - b.time : 0;
    });
    $('sector-loss-wrap').style.height = Math.max(220, nS*18) + 'px';
    const mx = Math.max(...losses);
    barChart('chart-sector-loss', losses.map((_,i) => `S${i+1}`), [{ data: losses, backgroundColor: losses.map(v => v > mx*0.66 ? '#ef4444' : v > mx*0.33 ? '#f59e0b' : '#3b82f6') }],
      { horizontal: true, x: { ticks: { callback: v => '+' + (+v).toFixed(2) + 's' } }, tooltip: { label: c => `avg +${c.parsed.x.toFixed(3)}s vs best (L${s.sectorBest[c.dataIndex]?.lap})` } });
  } else {
    killChart('chart-sector-loss'); $('sector-empty').classList.remove('hidden'); $('sector-loss-wrap').classList.add('hidden');
  }

  // Highlights
