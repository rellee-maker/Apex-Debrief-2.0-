<script>
'use strict';
// =====================================================================
// SHIFT-POINT ANALYSIS
// =====================================================================
const shiftKey = veh => `apexShift:${veh}`;
function shiftConfig(s) {
  let saved = null; try { saved = JSON.parse(localStorage.getItem(shiftKey(s.vehicle)) || 'null'); } catch {}
  const rpm = chData(s, 'rpm');
  const peak = rpm ? stats(rpm).max : 7000;
  const limit = Math.ceil(peak / 100) * 100;
  const def = { limit, target: limit - 300, band: Math.round(limit * 0.65 / 100) * 100, derived: true };
  return saved ? { ...def, ...saved, derived: false } : def;
}
['cfg-target', 'cfg-limit', 'cfg-band'].forEach(id => document.getElementById(id).addEventListener('change', () => {
  const s = sess(); if (!s) return;
  const cfg = { target: +$('cfg-target').value, limit: +$('cfg-limit').value, band: +$('cfg-band').value };
  if (![cfg.target, cfg.limit, cfg.band].every(v => isNum(v) && v > 0)) return;
  try { localStorage.setItem(shiftKey(s.vehicle), JSON.stringify(cfg)); } catch {}
  renderShift(s);
}));

function computeShifts(s, cfg) {
  const gearCh = chObj(s, 'gear'), rpm = chData(s, 'rpm');
  if (!gearCh || !rpm) return null;
  const G = gearCh.data, tps = chData(s, 'tps'), spd = chData(s, 'speed') || chData(s, 'wspeed'), D = s.lapDist, dt = 1 / s.hz;
  const stable = g => isNum(g) && g >= 1 && g <= 6 && Math.abs(g - Math.round(g)) < 0.01;
  const flying = s.laps.filter(l => l.type === 'flying');
  const shifts = [], perLap = [];
  const lugBins = new Map();
  flying.forEach(l => {
    let prevG = null, prevIdx = -1, lug = 0, lim = 0;
    for (let i = l.iStart; i <= l.iEnd; i++) {
      const g = G[i], r = rpm[i];
      if (r >= cfg.limit - 50) lim++;
      if (stable(g) && Math.round(g) >= 2 && tps && tps[i] > 90 && r < cfg.band && (!spd || spd[i] > 20)) {
        lug++; const bin = Math.floor(D[i] / 100) * 100; lugBins.set(bin, (lugBins.get(bin) || 0) + dt);
      }
      if (!stable(g)) continue;
      const gi = Math.round(g);
      if (prevG == null) { prevG = gi; prevIdx = i; continue; }
      if (gi !== prevG) {
        let ok = true;
        for (let k = 1; k <= 3 && i + k <= l.iEnd; k++) if (!stable(G[i + k]) || Math.round(G[i + k]) !== gi) { ok = false; break; }
        if (!ok) continue;
        if ((i - prevIdx) * dt > 1.5) { prevG = gi; prevIdx = i; continue; }
        if (gi > prevG) {
          let mx = -Infinity, at = prevIdx, tmax = 0;
          for (let k = Math.max(l.iStart, prevIdx - 10); k <= i; k++) if (rpm[k] > mx) { mx = rpm[k]; at = k; }
          if (tps) for (let k = Math.max(l.iStart, prevIdx - 20); k <= i; k++) tmax = Math.max(tmax, tps[k]);
          shifts.push({ dir: 'up', from: prevG, to: gi, rpm: mx, d: D[at], lap: l.num, wot: !tps || tmax > 80 });
        } else {
          let mx = -Infinity, at = i;
          for (let k = i; k <= Math.min(l.iEnd, i + 20); k++) if (rpm[k] > mx) { mx = rpm[k]; at = k; }
          shifts.push({ dir: 'down', from: prevG, to: gi, rpm: mx, d: D[at], lap: l.num, speed: spd ? spd[i] : NaN });
        }
        prevG = gi;
      }
      prevIdx = i;
    }
    const ups = shifts.filter(x => x.lap === l.num && x.dir === 'up' && x.wot);
    perLap.push({
      lap: l, ups: ups.length, avgUp: ups.length ? ups.reduce((a, x) => a + x.rpm, 0) / ups.length : NaN,
      early: ups.filter(x => x.rpm < cfg.target - 250).length,
      over: shifts.filter(x => x.lap === l.num && x.dir === 'down' && x.rpm > cfg.limit).length,
      lug: lug * dt, lim: lim * dt,
    });
  });
  const byType = {};
  shifts.forEach(x => { const k = `${x.from}→${x.to}`; (byType[k] = byType[k] || { key: k, dir: x.dir, from: x.from, to: x.to, list: [] }).list.push(x); });
  const types = Object.values(byType).map(t => {
    const v = t.list.filter(x => t.dir === 'down' || x.wot).map(x => x.rpm); const n = v.length;
    const avg = n ? v.reduce((a, b) => a + b, 0) / n : NaN;
    const sd = n > 1 ? Math.sqrt(v.reduce((a, b) => a + (b - avg) ** 2, 0) / n) : NaN;
    return { ...t, n, avg, sd, min: n ? Math.min(...v) : NaN, max: n ? Math.max(...v) : NaN,
      early: t.dir === 'up' ? v.filter(r => r < cfg.target - 250).length : 0,
      over: v.filter(r => r > cfg.limit).length };
  }).filter(t => t.n).sort((a, b) => (a.dir === b.dir ? (a.dir === 'up' ? a.from - b.from : b.from - a.from) : a.dir === 'up' ? -1 : 1));
  const worstLug = [...lugBins.entries()].sort((a, b) => b[1] - a[1])[0];
  return { shifts, perLap, types, flying, worstLug, cfg };
}

function renderShift(s) {
  const cfg = shiftConfig(s);
  $('cfg-target').value = cfg.target; $('cfg-limit').value = cfg.limit; $('cfg-band').value = cfg.band;
  $('cfg-note').innerText = cfg.derived ? 'Defaults come from this session\'s peak RPM — enter your engine\'s real shift point, limiter and power band (saved per car).' : `Saved for ${s.vehicle}.`;
  const R = computeShifts(s, cfg);
  if (!R || !R.flying.length) {
    $('shift-kpis').innerHTML = `<div class="col-span-full panel p-4 text-sm text-slate-400 font-mono">${!R ? 'This export has no recognisable gear or RPM channel.' : 'No flying laps to analyse.'}</div>`;
    ['shift-findings', 'shift-type-table', 'shift-lap-table'].forEach(id => $(id).innerHTML = ''); killChart('ch-shift'); return;
  }
  S.shiftResult = R;
  const nl = R.flying.length, ups = R.shifts.filter(x => x.dir === 'up' && x.wot), downs = R.shifts.filter(x => x.dir === 'down');
  const avgUp = ups.length ? ups.reduce((a, x) => a + x.rpm, 0) / ups.length : NaN;
  const early = ups.filter(x => x.rpm < cfg.target - 250).length, overRevs = downs.filter(x => x.rpm > cfg.limit).length;
  const lug = R.perLap.reduce((a, p) => a + p.lug, 0) / nl, lim = R.perLap.reduce((a, p) => a + p.lim, 0) / nl;
  const K = (l, v, sub, c) => `<div class="panel p-3"><div class="text-[10px] text-slate-400 font-mono kicker">${l}</div><div class="font-display font-bold text-2xl ${c}">${v}</div><div class="text-[10px] text-slate-500 font-mono">${sub}</div></div>`;
  $('shift-kpis').innerHTML = [
    K('UPSHIFTS / LAP', (ups.length / nl).toFixed(1), 'at full throttle', 'text-white'),
    K('AVG UPSHIFT', fmtNum(avgUp, 0), `rpm · target ${cfg.target}`, Math.abs(avgUp - cfg.target) < 200 ? 'text-emerald-400' : 'text-amber-400'),
