  const cur = setupKey(s);
  const rows = recs.map(r => {
    const sm = r.summary, prev = prevAtTrack[sm.track]; prevAtTrack[sm.track] = r;
    const dBest = prev && isNum(prev.summary.best) ? sm.best - prev.summary.best : NaN;
    const cells = showFields.map(f => {
      const v = (r.fields || {})[f.k] || '', pv = prev ? ((prev.fields || {})[f.k] || '') : v;
      return `<td class="p-2 ${prev && v !== pv ? 'changed' : 'text-slate-300'}" title="${prev && v !== pv ? `was ${esc(pv || '—')}` : ''}">${esc(v || '—')}</td>`;
    }).join('');
    const notes = [r.fields && r.fields.feedback, r.fields && r.fields.changes].filter(Boolean).join(' / ');
    return `<tr class="${r.key === cur ? 'bg-sky-500/10' : ''}">
      <td class="p-2">${esc(sm.date.replace(/^[A-Za-z]+,\s*/, ''))} <span class="text-slate-500">${esc(sm.clock)}</span></td><td class="p-2 text-amber-300">${esc(sm.track)}</td><td class="p-2">${esc(sm.driver)}</td>
      <td class="p-2 font-bold text-emerald-400">${fmtLap(sm.best)}</td><td class="p-2 ${isNum(dBest) ? (dBest < 0 ? 'text-emerald-400' : 'text-red-400') : 'text-slate-600'}">${isNum(dBest) ? fmtDelta(dBest) : '—'}</td>
      <td class="p-2 text-purple-300">${fmtLap(sm.theo)}</td><td class="p-2">${sm.air != null ? Math.round(sm.air) + '°' : '—'}</td><td class="p-2">${(r.fields && r.fields.trackTemp) ? r.fields.trackTemp + '°' : sm.trackEst != null ? '~' + Math.round(sm.trackEst) + '°' : '—'}</td>
      ${cells}<td class="p-2 text-slate-400 max-w-xs truncate" title="${esc(notes)}">${esc(notes || '—')}</td></tr>`;
  });
  $('hist-table').innerHTML = `<thead><tr class="text-slate-400 border-b border-racing-border bg-racing-cardBg"><th class="p-2">DATE</th><th class="p-2">TRACK</th><th class="p-2">DRIVER</th><th class="p-2">BEST</th><th class="p-2" title="vs previous session at the same track">Δ PREV</th><th class="p-2">THEO</th><th class="p-2">AIR</th><th class="p-2">TRACK</th>${showFields.map(f => `<th class="p-2" title="${esc(f.g)}">${esc(f.l)}</th>`).join('')}<th class="p-2">NOTES</th></tr></thead><tbody class="divide-y divide-racing-border/40">${rows.join('')}</tbody>`;
}
$('btn-hist-export').addEventListener('click', () => {
  const data = { app: 'apex-debrief', version: 1, exported: new Date().toISOString(), records: allSetups() };
  const a = document.createElement('a'); a.href = URL.createObjectURL(new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' }));
  a.download = `apex-debrief-setup-log-${new Date().toISOString().slice(0, 10)}.json`; document.body.appendChild(a); a.click(); a.remove();
});
$('hist-import').addEventListener('change', async e => {
  const f = e.target.files[0]; e.target.value = ''; if (!f) return;
  try {
    const d = JSON.parse(await f.text()); let n = 0;
    (d.records || []).forEach(r => { if (r.key && r.key.startsWith('apexSetup:')) { const { key, ...rest } = r; const ex = (() => { try { return JSON.parse(localStorage.getItem(key) || 'null'); } catch { return null; } })(); if (!ex || (rest.savedAt || 0) >= (ex.savedAt || 0)) { localStorage.setItem(key, JSON.stringify(rest)); n++; } } });
    alert(`Imported ${n} session record${n === 1 ? '' : 's'}.`); const s = sess(); if (s) renderSetup(s);
  } catch (err) { alert('Could not import: ' + err.message); }
});

// =====================================================================
// PDF DEBRIEF (print → Save as PDF)
// =====================================================================
$('btn-pdf').addEventListener('click', () => { const s = sess(); if (!s) return alert('Load a session first.'); buildReport(s); });
function buildReport(s) {
  const best = bestLap(s), flying = s.laps.filter(l => l.type === 'flying');
  const avg = flying.length ? flying.reduce((a, l) => a + l.seconds, 0) / flying.length : NaN;
  const sd = flying.length > 1 ? Math.sqrt(flying.reduce((a, l) => a + (l.seconds - avg) ** 2, 0) / flying.length) : NaN;
  const top = Math.max(...s.laps.map(l => l.topSpeed).filter(isNum));
  const w = s.weather && s.weather.status === 'ok' ? s.weather : null, mt = measuredTrackTemp(s);
  const rec = loadSetup(s) || { fields: {} };
  const { cards } = coachCards(s);
  const shifts = computeShifts(s, shiftConfig(s));
  const mech = mechEvals(s).filter(e => e.state !== 'ok');

  // Map image (light theme)
  let mapImg = '';
  if (s.hasGPS) { const c = $('report-map'); drawMap(c, s, best, { theme: 'light', width: 700, height: 520, dpr: 2, gateLabels: true }); mapImg = c.toDataURL('image/png'); }

  const kpi = (l, v) => `<div class="rp-kpi"><span>${l}</span><b>${v}</b></div>`;
  const lapRows = s.laps.filter(l => l.type !== 'partial').map(l => `<tr><td class="${l.isBest ? 'best' : ''}">L${l.num}</td><td class="${l.isBest ? 'best' : l.type === 'flying' ? '' : 'muted'}">${fmtLap(l.seconds)}</td><td class="muted">${l.isBest ? 'BEST' : fmtDelta(l.seconds - s.bestSeconds)}</td><td class="muted">${TYPE_STYLE[l.type][0].toLowerCase()}</td><td>${fmtNum(l.topSpeed, 1)}</td></tr>`).join('');
  const sectorCards = cards.filter(c => c.kind === 'sector').slice(0, 3);
  const generalCards = cards.filter(c => c.kind !== 'sector').slice(0, 2);
  const coach = [...sectorCards, ...generalCards].map(c => `<div class="rp-card ${c.color}"><b>${esc(c.title)}</b> <span class="muted">· ${esc(c.gain)}</span><div>${esc(c.findings)}</div><div><b>→</b> ${esc(c.rec)}</div></div>`).join('');
  const shiftHtml = shifts && shifts.flying.length ? `<table><thead><tr><th>Shift</th><th>n</th><th>Avg rpm</th><th>Range</th><th>Flags</th></tr></thead><tbody>${shifts.types.map(t => `<tr><td>${t.dir === 'up' ? '▲' : '▼'} ${t.key}</td><td>${t.n}</td><td>${fmtNum(t.avg, 0)}</td><td class="muted">${fmtNum(t.min, 0)}–${fmtNum(t.max, 0)}</td><td>${t.early ? t.early + ' early ' : ''}${t.over ? t.over + ' over-rev' : ''}</td></tr>`).join('')}</tbody></table>
    <div style="margin-top:4px">${shiftFindings(shifts).filter(([c]) => c !== 'ok').slice(0, 3).map(([, t]) => `<div>• ${esc(t)}</div>`).join('') || '<div>• Shift points on target.</div>'}</div>` : '<div class="muted">No gear/RPM data.</div>';
  const filled = ALL_FIELDS.filter(f => rec.fields[f.k] && !['feedback', 'changes'].includes(f.k));
  const setupHtml = filled.length ? `<div class="rp-grid2">${filled.map(f => `<div><span class="muted">${esc(f.g.replace(/ \(psi\)/, ''))} · ${esc(f.l)}:</span> ${esc(rec.fields[f.k])}</div>`).join('')}</div>` : '<div class="muted">No setup recorded for this session (Setup, Notes & Weather tab).</div>';
  const notes = ['feedback', 'changes'].filter(k => rec.fields[k]).map(k => `<div><b>${k === 'feedback' ? 'Driver feedback' : 'Changes / next time'}:</b> ${esc(rec.fields[k])}</div>`).join('');
  const wxLine = w ? `${Math.round(w.at.temp)}°F air · ${isNum(mt) ? Math.round(mt) + '°F track (measured)' : '~' + Math.round(w.trackEst) + '°F track (est.)'} · ${Math.round(w.at.rh)}% RH · wind ${Math.round(w.at.wind)} mph ${COMPASS(w.at.dir)}${isNum(w.headwind) ? ` (${Math.abs(w.headwind).toFixed(0)} mph ${w.headwind >= 0 ? 'head' : 'tail'}wind on straight)` : ''} · DA ${Math.round(w.densityAlt).toLocaleString()} ft` : (isNum(mt) ? `Track ${Math.round(mt)}°F (measured)` : 'Weather unavailable');

  $('report').innerHTML = `
    <div style="display:flex;justify-content:space-between;align-items:flex-end;border-bottom:3px solid #0f172a;padding-bottom:6px">
      <div><div class="rp-sub" style="letter-spacing:.2em;font-weight:700;color:#2563eb">APEX DEBRIEF · DRIVER REPORT</div><h1>${esc(s.driver)} — ${esc(s.track)}</h1>
      <div class="rp-sub">${esc(s.vehicle)} · ${esc([s.championship, metaVal(s.meta, 'Session')].filter(Boolean).join(' · '))} · ${esc(s.date)} ${esc(s.clock)}</div></div>
      <div class="rp-sub" style="text-align:right">${esc(wxLine)}<br>${esc(s.file)}</div>
    </div>
    <div class="rp-kpis">${kpi('BEST LAP', `${fmtLap(best.seconds)} <small style="font-size:9px;color:#64748b">L${best.num}</small>`)}${kpi('THEORETICAL', fmtLap(s.theo))}${kpi('AVG FLYING', fmtLap(avg))}${kpi('CONSISTENCY', isNum(sd) ? '±' + sd.toFixed(2) + 's' : '—')}${kpi('TOP SPEED', isNum(top) ? top.toFixed(1) + ' mph' : '—')}${kpi('LAPS', `${flying.length}/${s.laps.length} <small style="font-size:9px;color:#64748b">flying</small>`)}</div>
    <div class="rp-two" style="margin-top:8px">
      <div class="rp-section"><h2>Best lap — speed trace & splits</h2>${mapImg ? `<img src="${mapImg}">` : '<div class="muted">No GPS.</div>'}</div>
      <div class="rp-section"><h2>Lap times</h2><table><thead><tr><th>Lap</th><th>Time</th><th>Δ</th><th>Type</th><th>Top</th></tr></thead><tbody>${lapRows}</tbody></table></div>
    </div>
    <div class="rp-section"><h2>Where the time is — coaching</h2>${coach}</div>
    <div class="rp-two">
      <div class="rp-section"><h2>Shifting</h2>${shiftHtml}</div>
      <div class="rp-section"><h2>Engine & data flags</h2>${mech.length ? mech.map(e => `<div>• <b>${esc(e.m.label)}</b>: ${e.state === 'scale' ? 'sensor scaling needs checking' : e.state === 'dead' ? 'no signal' : `${fmtNum(e.v, 1)} ${e.m.unit} — ${e.state === 'red' ? 'ATTENTION' : 'watch'}`}</div>`).join('') : '<div>All monitored engine channels normal.</div>'}</div>
    </div>
    <div class="rp-section"><h2>Setup & notes</h2>${setupHtml}${notes ? `<div style="margin-top:6px">${notes}</div>` : ''}</div>
    <div class="rp-foot">Generated ${new Date().toLocaleString()} by Apex Debrief · all figures computed from the logged data${w ? ` · weather: Open-Meteo ${esc(w.source)}` : ''}.</div>`;
  const prevTitle = document.title;
  document.title = `${s.driver} ${s.track} ${sessionStartLocal(s)?.iso || ''} debrief`.replace(/\s+/g, ' ').trim();
  setTimeout(() => { window.print(); document.title = prevTitle; }, 150);
}
</script>
</body>
</html>
