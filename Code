  barChart('ch-tps-hist', lbl, [{ data: perLap(tb), backgroundColor: tb.map((_,i) => i >= 9 ? '#10b981' : i >= 5 ? '#f59e0b' : '#3b82f6') }], { y: { ticks: { callback: v => v + 's' } }, tooltip: { label: c => `${c.parsed.y.toFixed(2)} s per lap` } });
  barChart('ch-brake-hist', lbl, [{ data: perLap(bb), backgroundColor: bb.map((_,i) => i >= 7 ? '#ef4444' : i >= 4 ? '#f97316' : '#fbbf24') }], { y: { ticks: { callback: v => v + 's' } }, tooltip: { label: c => `${c.parsed.y.toFixed(2)} s per lap` } });

  const bestFull = Math.max(...per.map(p => p.full));
  $('input-table').innerHTML = `<thead><tr class="text-slate-400 border-b border-racing-border bg-racing-cardBg"><th class="p-2">LAP</th><th class="p-2">TIME</th><th class="p-2">AVG TPS</th><th class="p-2">FULL THROTTLE</th><th class="p-2">COASTING</th><th class="p-2">OVERLAP</th><th class="p-2">BRAKE ZONES</th><th class="p-2">TIME BRAKING</th></tr></thead><tbody class="divide-y divide-racing-border/40">` +
    per.map(p => `<tr class="${p.lap.isBest ? 'bg-emerald-500/5' : ''}"><td class="p-2 ${p.lap.isBest ? 'text-emerald-400 font-bold' : ''}">L${p.lap.num}</td><td class="p-2">${fmtLap(p.lap.seconds)}</td><td class="p-2">${fmtNum(p.avgTps,1)}%</td><td class="p-2 ${p.full >= bestFull - 1 ? 'text-emerald-400' : ''}">${fmtNum(p.full,1)}%</td><td class="p-2 ${p.coast > mean('coast')*1.3 ? 'text-amber-400' : ''}">${p.coast.toFixed(2)}s</td><td class="p-2 ${p.overlap > 0.5 ? 'text-orange-400' : ''}">${p.overlap.toFixed(2)}s</td><td class="p-2">${p.events}</td><td class="p-2">${p.brakeTime.toFixed(1)}s</td></tr>`).join('') + '</tbody>';
}

// =====================================================================
// MECHANIC
// =====================================================================
const MECH = [
  { k: 'ect', label: 'Coolant temp', agg: 'max', unit: '°F', rule: v => v > 230 ? 'red' : v > 215 ? 'amber' : 'ok' },
  { k: 'oilt', label: 'Oil temp', agg: 'max', unit: '°F', rule: v => v > 270 ? 'red' : v > 250 ? 'amber' : 'ok' },
  { k: 'oilp', label: 'Oil pressure (min @ >3000 rpm)', agg: 'minload', unit: 'psi', rule: v => v < 20 ? 'red' : v < 30 ? 'amber' : 'ok' },
  { k: 'fuelp', label: 'Fuel pressure (min)', agg: 'min', unit: 'psi', rule: v => v < 35 ? 'amber' : 'ok' },
  { k: 'battery', label: 'Battery (logger)', agg: 'avg', unit: 'V', rule: v => v < 12.8 ? 'amber' : v > 15 ? 'amber' : 'ok' },
  { k: 'ecuvolt', label: 'ECU supply', agg: 'avg', unit: 'V', rule: v => v < 12.8 ? 'amber' : v > 15 ? 'amber' : 'ok' },
  { k: 'lambda', label: 'Lambda @ WOT', agg: 'wot', unit: 'λ', rule: v => v > 0.95 ? 'amber' : v < 0.78 ? 'amber' : 'ok' },
  { k: 'airt', label: 'Intake air temp', agg: 'max', unit: '°F', rule: v => v > 130 ? 'amber' : 'ok' },
  { k: 'map', label: 'Manifold pressure (max)', agg: 'max', unit: 'psi', rule: () => 'ok' },
  { k: 'ign', label: 'Ignition advance (max)', agg: 'max', unit: '°', rule: () => 'ok' },
  { k: 'loggert', label: 'Logger temp', agg: 'max', unit: '°F', rule: v => v > 158 ? 'amber' : 'ok' },
