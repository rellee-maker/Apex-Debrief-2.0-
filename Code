    else if (t.max > cfg.limit) out.push(['red', `${t.key} upshifts reached ${Math.round(t.max)} rpm — at or past the ${cfg.limit} limit. Shift slightly earlier to stay off the limiter.`]);
    else out.push(['ok', `${t.key} upshifts average ${Math.round(t.avg)} rpm (±${Math.round(t.sd || 0)}), on target.`]);
    if (t.sd > 200) out.push(['info', `${t.key} shift point varies ±${Math.round(t.sd)} rpm lap to lap — a shift light or a consistent visual cue would tighten it.`]);
