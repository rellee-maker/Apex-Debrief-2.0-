  evals.filter(e => e.state === 'scale').forEach(e => N.push(['scale', `${e.ch.name}: ${e.ch.issues[0]?.text || 'value looks mis-scaled.'} Fix it in the Channel Audit tab (Scale) and this report will re-evaluate.`]));
