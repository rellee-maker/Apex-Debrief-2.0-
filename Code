<script>
'use strict';
// =====================================================================
// CORE (pure data — no DOM) =============================================
// =====================================================================
const FLY_PCT = 1.05; // laps within 105% of the best count as flying
const MPH_PER_KMH = 0.621371, PSI_PER_BAR = 14.5038, PSI_PER_KPA = 0.145038, FT_PER_M = 3.28084;

const norm = s => String(s ?? '').toLowerCase().replace(/[^a-z0-9]+/g, '');
const isNum = Number.isFinite;

function parseTimeValue(v) {
  const t = String(v ?? '').trim();
  if (!t) return NaN;
  if (t.includes(':')) {
    const p = t.split(':').map(Number);
    if (p.some(x => !isNum(x))) return NaN;
    return p.length === 3 ? p[0]*3600 + p[1]*60 + p[2] : p[0]*60 + p[1];
  }
  const n = Number(t);
  return isNum(n) ? n : NaN;
}

// Fast CSV parser (handles quotes, , or ; delimiters)
function parseDelimited(text) {
  text = text.replace(/^﻿/, '');
  const firstLine = text.slice(0, text.indexOf('\n') > 0 ? text.indexOf('\n') : text.length);
  const delim = (firstLine.match(/;/g) || []).length > (firstLine.match(/,/g) || []).length ? ';' : ',';
  const lines = text.split(/\r?\n/);
  const rows = new Array(lines.length);
  for (let li = 0; li < lines.length; li++) {
    const line = lines[li];
    if (!line) { rows[li] = []; continue; }
    if (line.indexOf('"') === -1) { rows[li] = line.split(delim); continue; }
    const out = []; let v = ''; let q = false;
    for (let i = 0; i < line.length; i++) {
      const c = line[i];
      if (c === '"') { if (q && line[i+1] === '"') { v += '"'; i++; } else q = !q; }
      else if (c === delim && !q) { out.push(v); v = ''; }
      else v += c;
    }
    out.push(v); rows[li] = out;
  }
  return rows;
}

// Logical channel lookup: exact normalized names first (in priority order), then "contains" for long aliases.
const CHANNEL_MAP = {
  time:    ['time','timestamp','elapsedtime'],
  speed:   ['gpsspeed','speed','vehiclespeed','groundspeed','velocity'],
  wspeed:  ['srfspeed','wheelspeed','ecuspeed'],
  rpm:     ['srfrpm','rpm','enginerpm','enginespeed'],
  tps:     ['srftps','tps','throttle','throttleposition','throttlepos','pps'],
  brake:   ['brakef','brakefront','brakepressfront','brakepressure','brakepress','brake'],
  braker:  ['braker','brakerear','brakepressrear'],
  steer:   ['steering','steeringangle','steeringring','steeringpos','steer'],
  latg:    ['gpslatacc','lateralacc','latacc','lateralg','latg'],
  lng:     ['gpslonacc','gpslongacc','longitudinala','longitudinalacc','longacc','longg'],
  gear:    ['srfgear','gear','currentgear'],
  lat:     ['gpslatitude','latitude','gpslat'],
  lon:     ['gpslongitude','longitude','gpslon','gpslong'],
  alt:     ['gpsaltitude','altitude'],
  dist:    ['distanceongpsspeed','distance','trackdistance','dist'],
  ect:     ['srfect','ect','coolanttemp','watertemp','enginetemp','clt'],
  oilt:    ['srfoilt','oiltemp','oiltemperature'],
  oilp:    ['srfoilp','oilpressure','oilpress','oilp'],
  fuelp:   ['srffuelp1','fuelpressure','fuelpress','fuelp'],
  map:     ['srfmap1','map','manifoldpressure','mapsensor'],
  lambda:  ['srflambda1','lambda1','lambda','afr','afr1'],
  airt:    ['srfairt','airtemp','iat','intakeairtemp'],
  ign:     ['srfignang','ignitionangle','ignangle','ignition'],
  battery: ['battery','vbatt','batteryvoltage'],
  ecuvolt: ['srfub','ecuvoltage'],
  loggert: ['dataloggertem','dataloggertemp','loggertemp'],
  nsat:    ['gpsnsat','nsat','satellites'],
  lapcol:  ['lapnumber','lapnum','lapno','lap'],
};
const ENGINE_KEYS = new Set(['rpm','ect','oilt','oilp','fuelp','map','lambda','airt','ign','ecuvolt','gear','wspeed','tps']);

function resolveLogical(names) {
  const keys = names.map(norm), map = {};
  for (const [logical, aliases] of Object.entries(CHANNEL_MAP)) {
    let idx = -1;
    for (const a of aliases) { idx = keys.indexOf(a); if (idx >= 0) break; }
    if (idx < 0) for (const a of aliases) { if (a.length < 5) continue; idx = keys.findIndex(k => k.includes(a)); if (idx >= 0) break; }
    if (idx >= 0) map[logical] = idx;
  }
  // GPS speed must never be resolved to the distance channel etc.
  if (map.speed != null && keys[map.speed].includes('distance')) delete map.speed;
  return map;
}

function median(arr) {
  const v = Array.from(arr).filter(isNum).sort((a,b)=>a-b);
  return v.length ? v[Math.floor(v.length/2)] : NaN;
}
function percentile(arr, p) {
  const v = Array.from(arr).filter(isNum).sort((a,b)=>a-b);
  return v.length ? v[Math.min(v.length-1, Math.floor(v.length*p))] : NaN;
}
function stats(arr, mask) {
  let mn = Infinity, mx = -Infinity, sum = 0, n = 0;
  for (let i = 0; i < arr.length; i++) {
    if (mask && !mask[i]) continue;
    const v = arr[i]; if (!isNum(v)) continue;
    if (v < mn) mn = v; if (v > mx) mx = v; sum += v; n++;
  }
  return n ? { min: mn, max: mx, avg: sum/n, n } : { min: NaN, max: NaN, avg: NaN, n: 0 };
}

// Convert a raw column to display units. Returns { data, unit, conv, notes[] }
function convertChannel(name, rawUnit, logical, raw) {
  const u = String(rawUnit || '').trim().toLowerCase();
  let data = raw, unit = String(rawUnit || '').trim(), conv = '', notes = [];
  const map = f => { const o = new Float64Array(raw.length); for (let i=0;i<raw.length;i++) o[i] = raw[i]*f; return o; };
  if (u === 'km/h' || u === 'kph') { data = map(MPH_PER_KMH); unit = 'mph'; conv = 'km/h → mph'; }
  else if (u === 'm/s' && (logical === 'speed' || /speed/i.test(name))) { data = map(2.23694); unit = 'mph'; conv = 'm/s → mph'; }
  else if (u === 'bar') { data = map(PSI_PER_BAR); unit = 'psi'; conv = 'bar → psi'; }
  else if (u === 'kpa') { data = map(PSI_PER_KPA); unit = 'psi'; conv = 'kPa → psi'; }
  else if (u === 'c' || u === '°c' || u === 'degc') { data = new Float64Array(raw.length); for (let i=0;i<raw.length;i++) data[i] = raw[i]*9/5+32; unit = '°F'; conv = '°C → °F'; }
  else if (u === 'mm') { data = map(0.001); unit = 'm'; conv = 'mm → m'; }
  else if (u === 'm' && logical === 'alt') { data = map(FT_PER_M); unit = 'ft'; conv = 'm → ft'; }
  else if (u === 'mv') { data = map(0.001); unit = 'V'; conv = 'mV → V'; }

  // Voltage sanity: some ECU streams arrive scaled ×1000 or ×1e6
  if (unit.toLowerCase() === 'v' || logical === 'battery' || logical === 'ecuvolt') {
    let med = median(data.filter ? data.filter(v => v !== 0) : data), f = 1;
    while (isNum(med) && med > 100) { med /= 1000; f /= 1000; }
    if (f !== 1) {
      const src = data; data = new Float64Array(src.length); for (let i=0;i<src.length;i++) data[i] = src[i]*f;
      unit = 'V'; conv = (conv ? conv + ', ' : '') + `auto-rescaled ×${f.toExponential(0)}`;
      notes.push({ level: 'info', text: `Values were ${1/f}× too large for a 12 V system — auto-corrected to volts.` });
    }
  }
  if ((u === 'a/f' || u === 'afr') && median(Array.from(raw).filter(v=>v>0)) < 3) {
    unit = 'λ'; conv = 'labelled A/F, values are λ';
    notes.push({ level: 'info', text: 'Labelled A/F in the file but values are lambda (≈1.0). Shown as λ (multiply by 14.7 for gasoline AFR).' });
  }
  if (logical === 'gear') {
    let bad = 0; const o = new Float64Array(raw.length);
    for (let i=0;i<raw.length;i++) { const g = raw[i]; if (g < 0 || g > 6) { o[i] = NaN; bad++; } else o[i] = g; }
    data = o; unit = 'gear';
    if (bad) notes.push({ level: 'info', text: `${bad.toLocaleString()} samples reported an out-of-range gear code (e.g. 9 = neutral/invalid). Ignored.` });
  }
  if (/radius/i.test(name)) {
    let s = 0; const o = Float64Array.from(data); for (let i=0;i<o.length;i++) if (o[i] >= 9999) { o[i] = NaN; s++; }
    if (s) { data = o; notes.push({ level: 'info', text: '10000 m = "straight line" placeholder; excluded from stats.' }); }
  }
  return { data, unit: unit || '—', conv, notes };
}

function splitAimSections(rows) {
  let headerIdx = -1;
  for (let i = 0; i < Math.min(rows.length, 80); i++) {
    const r = rows[i];
    if (r && r.length > 3 && norm(r[0]) === 'time') { headerIdx = i; break; }
  }
  if (headerIdx === -1) return null;
  const metadata = {};
  for (let i = 0; i < headerIdx; i++) {
    const r = rows[i]; if (!r || !r.length) continue;
    const k = String(r[0] ?? '').trim(); if (!k) continue;
    const vals = r.slice(1).map(v => String(v ?? '').trim()).filter(v => v !== '');
    metadata[k] = vals.length === 1 ? vals[0] : vals;
  }
  let start = headerIdx + 1, units = null;
  const cand = rows[start];
  if (cand && cand.length > 1) {
    const numeric = cand.filter(v => String(v).trim() !== '' && isNum(Number(v))).length;
    if (numeric < cand.length/2) { units = cand; start++; }
  }
  return { header: rows[headerIdx], units, metadata, dataStart: start };
}
const metaVal = (m, k) => { const v = m ? m[k] : undefined; return Array.isArray(v) ? v[0] : v; };

function buildSession(fileName, text, lastModified, calibration) {
  const rows = parseDelimited(text);
  const aim = splitAimSections(rows);
  const header = aim ? aim.header : rows[0];
  const units = aim ? aim.units : null;
  const meta = aim ? aim.metadata : {};
  let dataStart = aim ? aim.dataStart : 1;
  const ncol = header.length;
  const dataRows = [];
  for (let i = dataStart; i < rows.length; i++) {
    const r = rows[i];
    if (!r || r.length < Math.max(2, ncol/2)) continue;
    if (!r.some(v => String(v).trim() !== '')) continue;
    dataRows.push(r);
  }
  const n = dataRows.length;
  if (n < 10) throw new Error('No telemetry rows found — is this an AiM CSV export?');

  const names = header.map((h, i) => String(h || `Column ${i+1}`).trim());
  const logicalMap = resolveLogical(names);
  const logicalOf = {}; Object.entries(logicalMap).forEach(([k, i]) => { if (logicalOf[i] == null) logicalOf[i] = k; });

  // Columns
  const cols = names.map(() => new Float64Array(n));
  for (let r = 0; r < n; r++) {
    const row = dataRows[r];
    for (let c = 0; c < ncol; c++) {
      const s = row[c];
      cols[c][r] = (s === undefined || s === '' ) ? NaN : +s;
    }
  }

  // Time base
  const sampleRate = Number(metaVal(meta, 'Sample Rate'));
  let time;
  if (logicalMap.time != null && stats(cols[logicalMap.time]).n > n*0.9) time = cols[logicalMap.time];
  else { const dt = sampleRate > 0 ? 1/sampleRate : 0.1; time = new Float64Array(n); for (let i=0;i<n;i++) time[i] = i*dt; }
  const hz = sampleRate > 0 ? sampleRate : Math.round((n-1) / ((time[n-1] - time[0]) || 1));

  // Engine running mask
  const rpmRaw = logicalMap.rpm != null ? cols[logicalMap.rpm] : null;
  const running = new Uint8Array(n);
  for (let i=0;i<n;i++) running[i] = rpmRaw ? (rpmRaw[i] > 400 ? 1 : 0) : 1;

  const vehicle = metaVal(meta, 'Vehicle') || 'unknown';
  const channels = [];
  names.forEach((name, c) => {
    if (logicalMap.time === c) return;
    const logical = logicalOf[c] || null;
    const rawUnit = units ? String(units[c] ?? '').trim() : '';
    const cv = convertChannel(name, rawUnit, logical, cols[c]);
    const isEngine = (logical && ENGINE_KEYS.has(logical)) || /^srf\s/i.test(name);
    const ch = { name, rawUnit, unit: cv.unit, conv: cv.conv, logical, isEngine, base: cv.data, data: cv.data, notes: cv.notes, cal: { scale: 1, offset: 0 } };
    const cal = calibration && calibration(vehicle, name);
    if (cal && (cal.scale !== 1 || cal.offset !== 0)) applyCal(ch, cal);
    channels.push(ch);
  });

  const sess = {
    id: `s-${lastModified || 0}-${Math.random().toString(36).slice(2,8)}`,
    file: fileName, meta, n, hz, time, running, channels,
    track: metaVal(meta, 'Track') || metaVal(meta, 'Circuit') || metaVal(meta, 'Session') || 'Unknown track',
    driver: metaVal(meta, 'Racer') || metaVal(meta, 'Driver') || '—',
    vehicle, championship: metaVal(meta, 'Championship') || '',
    date: metaVal(meta, 'Date') || '', clock: metaVal(meta, 'Time') || '',
    comment: metaVal(meta, 'Comment') || '',
  };
  sess.L = {}; channels.forEach((ch, i) => { if (ch.logical && sess.L[ch.logical] == null) sess.L[ch.logical] = i; });
  finishSession(sess);
  return sess;
}

function applyCal(ch, cal) {
  ch.cal = { scale: cal.scale, offset: cal.offset };
  const o = new Float64Array(ch.base.length);
  for (let i=0;i<o.length;i++) o[i] = ch.base[i]*cal.scale + cal.offset;
  ch.data = o;
}

const chData = (sess, logical) => sess.L[logical] != null ? sess.channels[sess.L[logical]].data : null;
const chObj  = (sess, logical) => sess.L[logical] != null ? sess.channels[sess.L[logical]] : null;

// Everything derived from channel data — re-run after calibration changes.
function finishSession(sess) {
  auditChannels(sess);
  buildDerived(sess);
  buildLaps(sess);
  buildLapDistance(sess);
  sess.hasGPS = !!(chData(sess,'lat') && chData(sess,'lon') && stats(chData(sess,'lat')).n > 50);
  if (sess.hasGPS) buildXY(sess);
  lapSummaries(sess);
}

function auditChannels(sess) {
  const rpmS = chData(sess,'rpm') ? stats(chData(sess,'rpm'), sess.running) : null;
  sess.channels.forEach(ch => {
    const mask = ch.isEngine && chData(sess,'rpm') ? sess.running : null;
    ch.stats = stats(ch.data, mask);
    ch.allStats = stats(ch.data);
    const issues = ch.notes.slice();
    const s = ch.stats;
    let status = 'ok';
    const k = ch.logical, mx = s.max;
    if (!s.n || (s.max - s.min) < 1e-9) { status = 'dead'; issues.unshift({ level: 'dead', text: s.n ? `Flat at ${fmtNum(s.max)} for the whole session — sensor not connected or not configured.` : 'No numeric data.' }); }
    else {
      const sus = t => { status = 'suspect'; issues.unshift({ level: 'suspect', text: t }); };
      const peakRpm = rpmS ? Math.round(rpmS.max) : null;
      if (k === 'oilp' && mx < 15) sus(`Peak only ${fmtNum(mx)} psi${peakRpm ? ` while the engine reached ${peakRpm} rpm` : ''}. Real oil pressure under load is usually 40–70 psi — likely a scaling error in the RS3 ECU/CAN channel config.`);
      if (k === 'fuelp' && mx < 20) sus(`Peak only ${fmtNum(mx)} psi. A port-injected engine typically runs ~40–45 psi — likely a scaling error.`);
      if (k === 'map' && mx < 5) sus(`Peak only ${fmtNum(mx)} psi. Manifold pressure at full throttle should be close to atmospheric (~14 psi) — likely a scaling error.`);
      if ((k === 'brake' || k === 'braker') && mx < 100) sus(`Peak only ${fmtNum(mx)} psi. Hard stops normally show several hundred psi or more — check the sensor calibration. Brake analysis uses % of peak, so it still works.`);
      if ((k === 'battery' || k === 'ecuvolt') && (s.avg < 9 || s.avg > 16)) sus(`Average ${fmtNum(s.avg)} V is outside a 12 V system's range.`);
      if (/lateral acc/i.test(ch.name) && Math.abs(s.min) < 0.5*Math.abs(s.max)) issues.push({ level: 'info', text: `Range is lopsided (${fmtNum(s.min)} to ${fmtNum(s.max)} g) — check the logger's mounting orientation / IMU calibration. GPS LatAcc is used for analysis instead.` });
      if (ch.isEngine && chData(sess,'rpm') && ch.allStats.n > s.n) issues.push({ level: 'muted', text: `Stats exclude ${(ch.allStats.n - s.n).toLocaleString()} engine-off samples.` });
    }
    if (ch.cal && (ch.cal.scale !== 1 || ch.cal.offset !== 0)) { issues.push({ level: 'info', text: `User calibration applied: ×${ch.cal.scale}${ch.cal.offset ? ` + ${ch.cal.offset}` : ''}` }); if (status === 'suspect') status = 'ok'; }
    if (status === 'ok' && issues.some(i => i.level === 'info')) status = 'info';
    ch.status = status; ch.issues = issues;
  });
}

function buildDerived(sess) {
  const n = sess.n;
  // Brake as % of session peak, with rest offset removed (works even with bad sensor scaling)
  const b = chData(sess, 'brake'), tps = chData(sess, 'tps');
  if (b) {
    let rest = NaN;
    if (tps) { const v = []; for (let i=0;i<n;i++) if (tps[i] > 50) v.push(b[i]); rest = median(v); }
    if (!isNum(rest)) rest = percentile(b, 0.2);
    const peak = percentile(b, 0.999);
    const span = (peak - rest) || 1;
    const p = new Float64Array(n);
    for (let i=0;i<n;i++) p[i] = Math.max(0, Math.min(100, (b[i] - rest) / span * 100));
    sess.brakePct = p; sess.brakeRest = rest; sess.brakePeak = peak;
  } else sess.brakePct = null;
}

function buildLaps(sess) {
  const m = sess.meta, n = sess.n, t = sess.time;
  const laps = [];
  const beacons = Array.isArray(m['Beacon Markers']) ? m['Beacon Markers'].map(Number).filter(isNum)
                : (m['Beacon Markers'] != null ? [Number(m['Beacon Markers'])].filter(isNum) : []);
  const segs = Array.isArray(m['Segment Times']) ? m['Segment Times'].map(parseTimeValue) : [];
  const idxAt = time => { let lo = 0, hi = n-1; while (lo < hi) { const mid = (lo+hi)>>1; if (t[mid] < time) lo = mid+1; else hi = mid; } return lo; };
  if (beacons.length) {
    let prev = t[0];
    beacons.forEach((end, i) => {
      const seconds = isNum(segs[i]) ? segs[i] : end - prev;
      laps.push({ num: i+1, start: prev, end, seconds });
      prev = end;
    });
  } else if (sess.L.lapcol != null) {
    const lc = chData(sess, 'lapcol'); let cur = lc[0], s = t[0];
    for (let i=1;i<=n;i++) if (i === n || lc[i] !== cur) { laps.push({ num: laps.length+1, start: s, end: t[i-1], seconds: t[i-1]-s }); if (i<n) { cur = lc[i]; s = t[i]; } }
  } else {
    laps.push({ num: 1, start: t[0], end: t[n-1], seconds: t[n-1]-t[0] });
  }
  laps.forEach(l => { l.iStart = idxAt(l.start); l.iEnd = Math.max(l.iStart, Math.min(n-1, idxAt(l.end) - (t[idxAt(l.end)] > l.end ? 1 : 0))); });

  // Classify
  const N = laps.length;
  const med = median(laps.map(l => l.seconds));
  let cand = laps.map((_, i) => i).filter(i => laps[i].seconds > 0.6*med);
  if (N > 2) cand = cand.filter(i => i !== 0);
  if (!cand.length) cand = laps.map((_, i) => i);
  const best = Math.min(...cand.map(i => laps[i].seconds));
  laps.forEach((l, i) => {
    if (N > 2 && i === 0) l.type = 'out';
    else if (l.seconds < 0.6*med) l.type = 'partial';
    else if (l.seconds <= best*FLY_PCT) l.type = 'flying';
    else if (N > 2 && i === N-1) l.type = 'in';
    else l.type = 'slow';
    l.isBest = Math.abs(l.seconds - best) < 0.0005 && cand.includes(i);
  });
  sess.laps = laps; sess.bestSeconds = best;
}

function buildLapDistance(sess) {
  const n = sess.n, t = sess.time, D = new Float64Array(n).fill(NaN), lapOf = new Int16Array(n).fill(-1);
  const dist = chObj(sess, 'dist'), spd = chData(sess, 'speed') || chData(sess, 'wspeed');
  const distM = dist && /^(m|meters?)$/i.test(dist.unit) ? dist.data : null;
  sess.laps.forEach((l, li) => {
    let acc = 0, maxD = 0;
    for (let i = l.iStart; i <= l.iEnd; i++) {
      lapOf[i] = li;
      if (distM && isNum(distM[l.iStart])) acc = distM[i] - distM[l.iStart];
      else if (spd && i > l.iStart) { const v = spd[i]; if (isNum(v)) acc += v*0.44704*(t[i]-t[i-1]); }
      if (!isNum(acc)) acc = maxD;
      maxD = Math.max(maxD, acc); D[i] = maxD; // monotonic
    }
    l.length = maxD;
  });
  sess.lapDist = D; sess.lapOf = lapOf;
}

function buildXY(sess) {
  const lat = chData(sess,'lat'), lon = chData(sess,'lon'), n = sess.n;
  const st = stats(lat), so = stats(lon);
  const lat0 = (st.min+st.max)/2, lon0 = (so.min+so.max)/2, k = Math.cos(lat0*Math.PI/180);
  const X = new Float64Array(n), Y = new Float64Array(n);
  for (let i=0;i<n;i++) {
    if (!isNum(lat[i]) || !isNum(lon[i]) || lat[i] === 0) { X[i] = NaN; Y[i] = NaN; continue; }
    X[i] = (lon[i]-lon0)*111320*k; Y[i] = (lat[i]-lat0)*110574;
  }
  sess.X = X; sess.Y = Y; sess.proj = (la, lo) => [(lo-lon0)*111320*k, (la-lat0)*110574];
}

function lapSummaries(sess) {
  const spd = chData(sess,'speed') || chData(sess,'wspeed');
  sess.laps.forEach(l => {
    let mx = -Infinity;
    if (spd) for (let i=l.iStart;i<=l.iEnd;i++) if (spd[i] > mx) mx = spd[i];
    l.topSpeed = isNum(mx) ? mx : NaN;
  });
}

// ---------- Track splits ----------
function parseTrackFile(text, fileName) {
  const ext = fileName.split('.').pop().toLowerCase();
  if (ext === 'amss') {
    let data; try { data = JSON.parse(text); } catch (e) { throw new Error('AMSS file is not valid JSON.'); }
    const raw = data.sectors || data.Sectors || [];
    if (!raw.length) throw new Error('No split points found in AMSS file.');
    // Every point in an RS3 split sequence is a split gate (type is RS3's split style, not on/off).
    const gates = raw.slice().sort((a,b) => (a.index ?? 0) - (b.index ?? 0)).map((g, i) => ({
      name: String(g.name || g.gate_point_name || (i+1)), lat: g.gate_point_latitude/1e7, lon: g.gate_point_longitude/1e7, type: g.type, index: g.index ?? i+1,
    })).filter(g => isNum(g.lat) && isNum(g.lon) && g.lat !== 0);
    return { mode: 'gps', name: (data.sequence && data.sequence.name) || fileName.replace(/\.[^.]+$/, ''), gates, file: fileName };
  }
  // ASD (INI): [Sector_N] Distance=
  const sectors = []; let cur = null, trackName = null;
  text.split(/\r?\n/).forEach(raw => {
    const line = raw.trim(); if (!line || line.startsWith(';') || line.startsWith('//')) return;
    const sec = line.match(/^\[(.+)\]$/);
    if (sec) { const s = sec[1].toLowerCase(); cur = s.startsWith('sector') ? (sectors.push({}), sectors[sectors.length-1]) : (s === 'track' ? { _track: true } : null); return; }
    const kv = line.match(/^([^=]+)=(.*)$/);
    if (kv && cur) { if (cur._track && kv[1].trim().toLowerCase() === 'name') trackName = kv[2].trim(); else cur[kv[1].trim().toLowerCase()] = kv[2].trim(); }
  });
  const ds = sectors.map(s => Number(s.distance ?? s.startdistance)).filter(d => isNum(d) && d > 0).sort((a,b)=>a-b);
  if (!ds.length) throw new Error('No sector distances found in ASD file.');
  return { mode: 'distance', name: trackName || fileName, distances: ds, file: fileName };
}

function segIntersect(ax, ay, bx, by, cx, cy, dx, dy) {
  const rx = bx-ax, ry = by-ay, sx = dx-cx, sy = dy-cy;
  const den = rx*sy - ry*sx; if (Math.abs(den) < 1e-12) return -1;
  const qx = cx-ax, qy = cy-ay;
  const t = (qx*sy - qy*sx)/den, u = (qx*ry - qy*rx)/den;
  return (t >= 0 && t <= 1 && u >= 0 && u <= 1) ? t : -1;
}

function bestLap(sess) { return sess.laps.find(l => l.isBest) || sess.laps.find(l => l.type === 'flying') || sess.laps[0]; }

// Sector timing via gate-line crossings (like RS3): each split point becomes a line
// perpendicular to the racing line, and crossings are interpolated between samples.
function computeSectors(sess, track) {
  sess.gates = null; sess.sectorCount = 0; sess.sectorSource = null; sess.gatesNearSF = 0;
  sess.laps.forEach(l => { l.sectors = []; l.bounds = []; l.boundIdx = []; });
  if (!track) { sess.theo = NaN; return; }
  const t = sess.time, D = sess.lapDist;
  const interpIdx = (i, f) => ({ time: t[i] + f*(t[i+1]-t[i]), d: D[i] + f*(D[i+1]-D[i]) });

  if (track.mode === 'gps') {
    if (!sess.hasGPS) { sess.theo = NaN; return; }
    const ref = bestLap(sess), X = sess.X, Y = sess.Y, W = 30;
    const gates = [];
    track.gates.forEach(g => {
      const [gx, gy] = sess.proj(g.lat, g.lon);
      let best = Infinity, k = -1;
      for (let i = ref.iStart; i <= ref.iEnd; i++) { const dx = X[i]-gx, dy = Y[i]-gy, d2 = dx*dx+dy*dy; if (d2 < best) { best = d2; k = i; } }
      if (k < 0 || Math.sqrt(best) > 60) return; // gate not on this trace
      // A split point sitting on top of the beacon line just creates a sub-second noise sector
      if (D[k] < 40 || ref.length - D[k] < 40) { sess.gatesNearSF = (sess.gatesNearSF || 0) + 1; return; }
      const a = Math.max(ref.iStart, k-3), b = Math.min(ref.iEnd, k+3);
      let hx = X[b]-X[a], hy = Y[b]-Y[a]; const hn = Math.hypot(hx, hy) || 1; hx /= hn; hy /= hn;
      gates.push({ ...g, gx, gy, hx, hy, x1: gx - hy*W, y1: gy + hx*W, x2: gx + hy*W, y2: gy - hx*W, refD: D[k], offset: Math.sqrt(best) });
    });
    gates.sort((a,b) => a.refD - b.refD);
    if (!gates.length) { sess.theo = NaN; sess.gateMiss = true; return; }
    sess.gates = gates; sess.sectorSource = `${gates.length} gates · ${track.name}${sess.gatesNearSF ? ` (${sess.gatesNearSF} on S/F line merged)` : ''}`;
    sess.gateMiss = Math.max(0, track.gates.length - gates.length - sess.gatesNearSF);
    sess.laps.forEach(l => {
      let cur = l.iStart; const cross = [];
      gates.forEach(g => {
        let found = null;
        for (let i = cur; i < l.iEnd; i++) {
          if (!isNum(X[i]) || !isNum(X[i+1])) continue;
          const mx = X[i+1]-X[i], my = Y[i+1]-Y[i];
          if (mx*g.hx + my*g.hy <= 0) continue;
          const f = segIntersect(X[i], Y[i], X[i+1], Y[i+1], g.x1, g.y1, g.x2, g.y2);
          if (f >= 0) { found = { ...interpIdx(i, f), i }; cur = i+1; break; }
        }
        cross.push(found);
      });
      finishLapSectors(l, cross);
    });
  } else {
    sess.sectorSource = `${track.distances.length+1} sectors · ${track.name}`;
    sess.laps.forEach(l => {
      let cur = l.iStart; const cross = [];
      track.distances.forEach(d => {
        let found = null;
        for (let i = cur; i < l.iEnd; i++) if (D[i] <= d && D[i+1] > d) { const f = (d - D[i])/(D[i+1]-D[i]); found = { ...interpIdx(i, f), i }; cur = i+1; break; }
        cross.push(found);
      });
      finishLapSectors(l, cross);
    });
  }
  sess.sectorCount = sess.laps.reduce((m, l) => Math.max(m, l.sectors.length), 0);
  // Session best per sector & theoretical best (all laps except out/in/partial)
  const eligible = sess.laps.filter(l => l.type === 'flying' || l.type === 'slow');
  sess.sectorBest = [];
  for (let s = 0; s < sess.sectorCount; s++) {
    let best = Infinity, lap = null;
    eligible.forEach(l => { const v = l.sectors[s]; if (isNum(v) && v < best) { best = v; lap = l.num; } });
    sess.sectorBest.push(isNum(best) ? { time: best, lap } : null);
  }
  sess.theo = sess.sectorBest.length && sess.sectorBest.every(Boolean) ? sess.sectorBest.reduce((a, b) => a + b.time, 0) : NaN;
}

function finishLapSectors(l, cross) {
  const bounds = [{ time: l.start, d: 0, i: l.iStart }, ...cross, { time: l.start + l.seconds, d: l.length, i: l.iEnd }];
  l.bounds = bounds; l.sectors = [];
  for (let s = 0; s < bounds.length-1; s++) {
    const a = bounds[s], b = bounds[s+1];
    l.sectors.push(a && b && b.time > a.time ? b.time - a.time : NaN);
  }
}

// Resample a channel over a lap onto a distance grid (linear interpolation)
function lapSeries(sess, lap, arr, grid, scale = 1, timeMode = false) {
  const D = sess.lapDist, out = new Float64Array(grid.length);
  let j = lap.iStart;
  for (let g = 0; g < grid.length; g++) {
    const target = grid[g]*scale;
    while (j < lap.iEnd && D[j+1] <= target) j++;
    let v;
    if (j >= lap.iEnd) v = arr[lap.iEnd];
    else { const d0 = D[j], d1 = D[j+1], f = d1 > d0 ? (target-d0)/(d1-d0) : 0; v = arr[j] + Math.max(0, Math.min(1, f))*(arr[j+1]-arr[j]); }
    out[g] = timeMode ? v - lap.start : v;
  }
  return out;
}
function lapGrid(lap, step = 2) { const n = Math.max(2, Math.floor(lap.length/step)+1), g = new Float64Array(n); for (let i=0;i<n;i++) g[i] = Math.min(lap.length, i*step); return g; }

// Per-lap per-sector metrics for coaching
function sectorMetrics(sess, lap, s) {
  const a = lap.bounds[s], b = lap.bounds[s+1]; if (!a || !b) return null;
  const spd = chData(sess,'speed') || chData(sess,'wspeed'), tps = chData(sess,'tps'), bp = sess.brakePct, D = sess.lapDist, t = sess.time;
  const i0 = a.i, i1 = Math.max(a.i, b.i);
  let minS = Infinity, minD = NaN, brakeD = NaN, tpsSum = 0, fullT = 0, cnt = 0, coast = 0;
  for (let i = i0; i <= i1; i++) {
    if (spd && spd[i] < minS) { minS = spd[i]; minD = D[i] - a.d; }
    if (bp && isNaN(brakeD) && bp[i] > 25) brakeD = D[i] - a.d;
    if (tps) { tpsSum += tps[i]; if (tps[i] >= 90) fullT++; if (tps[i] < 5 && (!bp || bp[i] < 5) && spd && spd[i] > 20) coast++; }
    cnt++;
  }
  const dt = cnt > 1 ? (t[i1]-t[i0])/(cnt-1) : 0;
  return {
    entry: spd ? spd[i0] : NaN, exit: spd ? spd[i1] : NaN, min: isNum(minS) ? minS : NaN, minD,
    brakeD, avgTps: tps && cnt ? tpsSum/cnt : NaN, fullPct: tps && cnt ? 100*fullT/cnt : NaN, coastS: coast*dt, len: b.d - a.d,
  };
}

function fmtNum(v, d) {
  if (!isNum(v)) return '—';
  if (d == null) d = Math.abs(v) >= 1000 ? 0 : Math.abs(v) >= 100 ? 1 : Math.abs(v) >= 1 ? 2 : 3;
  return v.toFixed(d);
}
function fmtLap(s) { if (!isNum(s)) return '—'; const m = Math.floor(s/60), r = s - m*60; return `${m}:${r.toFixed(3).padStart(6, '0')}`; }
function fmtDelta(s, d = 3) { if (!isNum(s)) return '—'; return (s >= 0 ? '+' : '−') + Math.abs(s).toFixed(d); }
// ==== CORE END ====
</script>

<script>
'use strict';
// =====================================================================
// UI ==================================================================
// =====================================================================
const S = { sessions: [], active: null, track: null, tab: 'snapshot', ref: null, cmp: null, cursorD: 0, charts: {}, grid: null, series: null };
const $ = id => document.getElementById(id);
const esc = v => String(v ?? '').replace(/[&<>'"]/g, c => ({ '&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;' }[c]));
const sess = () => S.sessions.find(s => s.id === S.active) || null;

// ---- calibration persistence (per vehicle + channel, this browser only)
const calKey = (veh, ch) => `apexCal:${veh}:${ch}`;
function loadCal(veh, ch) { try { const v = localStorage.getItem(calKey(veh, ch)); return v ? JSON.parse(v) : null; } catch { return null; } }
function saveCal(veh, ch, cal) { try { if (cal.scale === 1 && cal.offset === 0) localStorage.removeItem(calKey(veh, ch)); else localStorage.setItem(calKey(veh, ch), JSON.stringify(cal)); } catch {} }

// ---- chart helpers
const cursorPlugin = {
  id: 'cursor',
  afterDatasetsDraw(chart) {
    const x = chart.options.plugins.cursor && chart.options.plugins.cursor.x;
    if (x == null || !chart.scales.x) return;
    const px = chart.scales.x.getPixelForValue(x), { top, bottom } = chart.chartArea;
    if (px < chart.chartArea.left || px > chart.chartArea.right) return;
    const ctx = chart.ctx; ctx.save(); ctx.strokeStyle = 'rgba(226,232,240,.55)'; ctx.lineWidth = 1; ctx.setLineDash([3,3]);
    ctx.beginPath(); ctx.moveTo(px, top); ctx.lineTo(px, bottom); ctx.stroke(); ctx.restore();
  }
};
if (window.Chart) {
  Chart.register(cursorPlugin);
  Chart.defaults.color = '#94a3b8'; Chart.defaults.font.family = "'JetBrains Mono', monospace"; Chart.defaults.font.size = 10;
}
function killChart(id) { if (S.charts[id]) { S.charts[id].destroy(); delete S.charts[id]; } }
const xy = (grid, arr) => { const o = new Array(grid.length); for (let i=0;i<grid.length;i++) o[i] = { x: grid[i], y: isNum(arr[i]) ? arr[i] : null }; return o; };
function lineChart(id, datasets, opts = {}) {
  killChart(id);
  const el = $(id); if (!el || !window.Chart) return null;
  const scales = {
    x: { type: 'linear', min: opts.xMin, max: opts.xMax, grid: { color: '#1f2937' }, ticks: { maxTicksLimit: 12, callback: opts.xTick || (v => Math.round(v) + 'm') } },
    y: { grid: { color: '#1f2937' }, min: opts.yMin, max: opts.yMax, ticks: { maxTicksLimit: 6 } },
  };
  if (opts.y2) scales.y2 = { position: 'right', grid: { display: false }, ...opts.y2 };
  const ch = new Chart(el.getContext('2d'), {
    type: 'line',
    data: { datasets: datasets.map(d => ({ pointRadius: 0, borderWidth: 1.5, spanGaps: true, tension: 0, ...d })) },
    options: {
      responsive: true, maintainAspectRatio: false, animation: false, parsing: false, normalized: true,
      interaction: { mode: 'nearest', axis: 'x', intersect: false },
      plugins: { legend: { display: !!opts.legend, labels: { boxWidth: 14, padding: 8 } }, cursor: { x: opts.cursor ? S.cursorD : null },
        tooltip: { enabled: opts.tooltip !== false, callbacks: { title: items => items.length ? (opts.xTick || (v => Math.round(v)+' m'))(items[0].parsed.x) : '' } } },
      scales,
      onHover: opts.cursor ? (e, _, chart) => { const v = chart.scales.x.getValueForPixel(e.x); if (isNum(v)) setCursor(v); } : undefined,
    }
  });
  S.charts[id] = ch; return ch;
}
function barChart(id, labels, datasets, opts = {}) {
  killChart(id);
  const el = $(id); if (!el || !window.Chart) return null;
  const ch = new Chart(el.getContext('2d'), {
    type: 'bar', data: { labels, datasets: datasets.map(d => ({ borderRadius: 3, ...d })) },
    options: { responsive: true, maintainAspectRatio: false, animation: false, indexAxis: opts.horizontal ? 'y' : 'x',
      plugins: { legend: { display: false }, tooltip: { callbacks: opts.tooltip || {} } },
      scales: { x: { grid: { display: !!opts.horizontal, color: '#1f2937' }, ...(opts.x || {}) }, y: { grid: { color: '#1f2937' }, ...(opts.y || {}) } },
      onClick: opts.onClick }
  });
  S.charts[id] = ch; return ch;
}

// ---- file handling
$('csv-input').addEventListener('change', e => { handleFiles(Array.from(e.target.files)); e.target.value = ''; });
$('track-input').addEventListener('change', e => { handleFiles(Array.from(e.target.files)); e.target.value = ''; });
['dragenter','dragover'].forEach(ev => document.addEventListener(ev, e => { e.preventDefault(); $('empty-state').classList.add('drop-active'); }));
['dragleave','drop'].forEach(ev => document.addEventListener(ev, e => { e.preventDefault(); $('empty-state').classList.remove('drop-active'); }));
document.addEventListener('drop', e => { if (e.dataTransfer && e.dataTransfer.files.length) handleFiles(Array.from(e.dataTransfer.files)); });

async function handleFiles(files) {
  const trackFiles = files.filter(f => /\.(amss|asd)$/i.test(f.name));
  const rawFiles = files.filter(f => /\.(drk|xrk|gpk|rrk|bak)$/i.test(f.name));
  const csvFiles = files.filter(f => /\.(csv|txt)$/i.test(f.name));
  if (rawFiles.length) alert(`${rawFiles.map(f=>f.name).join(', ')}: raw AiM logger files can't be decoded in a browser.\n\nIn Race Studio 3: right-click the session → "Export items as…" → CSV, then upload the .csv here.\nTip: Settings → Download Preferences → "Create CSV file(s) on download" makes RS3 produce the CSV automatically.`);
  for (const f of trackFiles) {
    try { S.track = parseTrackFile(await f.text(), f.name); }
    catch (err) { alert(`${f.name}: ${err.message}`); }
  }
  if (csvFiles.length) {
    showLoading(`Parsing ${csvFiles.length} file${csvFiles.length > 1 ? 's' : ''}…`);
    await new Promise(r => setTimeout(r, 30));
    for (const f of csvFiles) {
      try {
        showLoading(`Parsing ${f.name}…`); await new Promise(r => setTimeout(r, 10));
        const s = buildSession(f.name, await f.text(), f.lastModified, loadCal);
        S.sessions.push(s); S.active = s.id;
      } catch (err) { console.error(err); alert(`Could not read ${f.name}: ${err.message}`); }
    }
    hideLoading();
  }
  S.sessions.forEach(s => { computeSectors(s, S.track); saveSessionSummary(s); });
  if (sess()) { resetLapSelection(); renderAll(); S.sessions.forEach(s => fetchWeather(s)); }
  else renderEmptyTrackStatus();
}
