const TYPE_STYLE = {
  flying: ['FLYING', 'text-slate-200', 'bg-emerald-500/10 text-emerald-300 border-emerald-500/30'],
  slow: ['SLOW / CAUTION', 'text-amber-300', 'bg-amber-500/10 text-amber-300 border-amber-500/30'],
