function mechValue(s, m, lap) {
  const ch = chObj(s, m.k); if (!ch) return NaN;
  const d = ch.data, rpm = chData(s,'rpm'), tps = chData(s,'tps');
  const i0 = lap ? lap.iStart : 0, i1 = lap ? lap.iEnd : s.n-1;
  let mn = Infinity, mx = -Infinity, sum = 0, n = 0;
  for (let i = i0; i <= i1; i++) {
