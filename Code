<!DOCTYPE html>
<html lang="en" class="dark">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Apex Debrief — Race Engineering Dashboard</title>
<script src="https://cdn.tailwindcss.com"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@500;600;700&family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
<script>
if (window.tailwind) tailwind.config = {
  darkMode: 'class',
  theme: { extend: {
    fontFamily: { sans: ['Inter','sans-serif'], mono: ['JetBrains Mono','monospace'], display: ['Chakra Petch','sans-serif'] },
    colors: { racing: { darkBg:'#0b1018', panelBg:'#121a25', cardBg:'#182231', border:'#293648' } }
  } }
};
</script>
<style>
  body { background:#0b1018; color:#e5e7eb; font-family:'Inter',sans-serif; overflow-x:hidden; }
  .font-display { font-family:'Chakra Petch',sans-serif; }
  .font-mono { font-family:'JetBrains Mono',monospace; }
  ::-webkit-scrollbar { width:6px; height:6px; }
  ::-webkit-scrollbar-track { background:#111827; }
  ::-webkit-scrollbar-thumb { background:#374151; border-radius:3px; }
  ::-webkit-scrollbar-thumb:hover { background:#3b82f6; }
  .technical-grid { background-image:linear-gradient(rgba(71,85,105,.07) 1px,transparent 1px),linear-gradient(90deg,rgba(71,85,105,.07) 1px,transparent 1px); background-size:24px 24px; }
  .panel { background:#121a25; border:1px solid #293648; border-radius:.75rem; }
  .card { background:#182231; border:1px solid #293648; border-radius:.5rem; }
  .kicker { letter-spacing:.16em; }
  .drop-active { border-color:#3b82f6 !important; background:rgba(59,130,246,.08) !important; }
  .tab-btn.active { background:rgba(37,99,235,.2); color:#60a5fa; border-color:rgba(59,130,246,.4); }
  th.sticky-col, td.sticky-col { position:sticky; left:0; background:#121a25; z-index:1; }
  input[type=range] { accent-color:#3b82f6; }
  select, input[type=number] { background:#0b1018; border:1px solid #293648; color:#e2e8f0; border-radius:.375rem; padding:.25rem .5rem; }
  .chart-box { position:relative; }
  .changed { background:rgba(245,158,11,.15); color:#fcd34d; }
  #report { display:none; }
  @media print {
    @page { size: letter; margin: 0.45in; }
    html, body { background:#fff !important; }
    body > *:not(#report) { display:none !important; }
    #report { display:block !important; }
  }
  #report { font-family: Inter, Arial, sans-serif; color:#0f172a; font-size:10.5px; line-height:1.4; }
  #report h1 { font-size:20px; font-weight:800; margin:0; letter-spacing:.02em; }
  #report h2 { font-size:11px; font-weight:800; letter-spacing:.12em; text-transform:uppercase; color:#1e3a8a; border-bottom:1.5px solid #1e3a8a; padding-bottom:2px; margin:12px 0 6px; }
  #report .rp-sub { color:#475569; font-size:10px; }
  #report .rp-kpis { display:grid; grid-template-columns:repeat(6,1fr); gap:6px; margin-top:8px; }
  #report .rp-kpi { border:1px solid #cbd5e1; border-radius:6px; padding:5px 7px; }
  #report .rp-kpi b { display:block; font-size:15px; font-family:'JetBrains Mono',monospace; }
  #report .rp-kpi span { font-size:8.5px; color:#64748b; letter-spacing:.08em; }
  #report .rp-two { display:grid; grid-template-columns:1.15fr 1fr; gap:12px; align-items:start; }
  #report table { width:100%; border-collapse:collapse; font-family:'JetBrains Mono',monospace; font-size:9.5px; }
  #report th { text-align:left; color:#64748b; font-weight:600; border-bottom:1px solid #cbd5e1; padding:2px 4px; }
  #report td { border-bottom:1px solid #eef2f7; padding:2px 4px; }
  #report .best { color:#047857; font-weight:700; }
  #report .muted { color:#94a3b8; }
  #report .rp-card { border-left:3px solid #2563eb; padding:4px 8px; margin-bottom:6px; break-inside:avoid; }
  #report .rp-card.red { border-color:#dc2626; } #report .rp-card.amber { border-color:#d97706; } #report .rp-card.emerald { border-color:#059669; }
  #report .rp-card b { font-size:10.5px; }
  #report .rp-grid2 { display:grid; grid-template-columns:1fr 1fr; gap:4px 16px; }
  #report .rp-foot { margin-top:10px; color:#94a3b8; font-size:8.5px; border-top:1px solid #e2e8f0; padding-top:4px; }
  #report img { width:100%; border:1px solid #e2e8f0; border-radius:6px; }
  #report .rp-section { break-inside:avoid; }
</style>
</head>
<body class="min-h-screen flex flex-col antialiased technical-grid text-slate-200">

<header class="border-b border-racing-border bg-racing-panelBg/95 backdrop-blur sticky top-0 z-50 px-4 py-3">
  <div class="max-w-7xl mx-auto flex flex-col lg:flex-row lg:items-center justify-between gap-3">
    <div class="flex items-center gap-3 min-w-0">
      <div class="h-10 w-10 shrink-0 rounded-lg bg-blue-600/20 border border-blue-500/40 flex items-center justify-center text-blue-400 text-xl"><i class="fa-solid fa-chart-diagram"></i></div>
      <div class="min-w-0">
        <div class="flex items-center gap-2 flex-wrap">
          <h1 class="font-display font-bold text-xl tracking-wider text-white">APEX DEBRIEF</h1>
          <span class="text-[10px] px-2 py-0.5 rounded bg-blue-500/20 border border-blue-500/40 text-blue-300 font-mono kicker">RACE ENGINEERING</span>
          <span id="session-badge" class="text-[10px] px-2 py-0.5 rounded bg-slate-700/40 border border-slate-600 text-slate-300 font-semibold">NO DATA LOADED</span>
        </div>
        <p class="text-xs text-slate-400 font-mono mt-0.5 truncate">
          TRACK: <span id="hdr-track" class="text-amber-400 font-semibold">—</span> |
          VEHICLE: <span id="hdr-vehicle" class="text-slate-200 font-semibold">—</span> |
          DRIVER: <span id="hdr-driver" class="text-slate-200 font-semibold">—</span> |
          DATE: <span id="hdr-date" class="text-slate-200 font-semibold">—</span>
        </p>
      </div>
    </div>
    <div class="flex flex-wrap items-center gap-2 text-xs">
      <label for="csv-input" class="cursor-pointer bg-blue-600 hover:bg-blue-500 text-white font-medium px-3.5 py-2 rounded-lg transition flex items-center gap-2"><i class="fa-solid fa-file-waveform"></i> Upload Telemetry <span class="opacity-60">.csv</span></label>
      <input id="csv-input" type="file" accept=".csv,.txt,.xrk,.drk,.gpk,.rrk,.bak" multiple class="hidden">
      <label for="track-input" class="cursor-pointer bg-purple-700 hover:bg-purple-600 text-white font-medium px-3.5 py-2 rounded-lg transition flex items-center gap-2"><i class="fa-solid fa-map-pin"></i> Track Splits <span class="opacity-60">.amss/.asd</span></label>
      <input id="track-input" type="file" accept=".amss,.asd" class="hidden">
 <button id="btn-pdf" class="bg-emerald-600/90 hover:bg-emerald-500 text-white px-3 py-2 rounded-lg transition flex items-center gap-2 font-medium"><i class="fa-solid fa-file-pdf"></i> PDF Debrief</button>
      <button id="btn-export" class="bg-racing-cardBg hover:bg-slate-700 text-slate-200 border border-racing-border px-3 py-2 rounded-lg transition flex items-center gap-2 font-mono"><i class="fa-solid fa-download text-blue-400"></i> Export Clean CSV</button>
      <button id="btn-clear" class="bg-red-500/10 hover:bg-red-500/20 text-red-300 border border-red-500/40 px-3 py-2 rounded-lg transition flex items-center gap-2 font-mono"><i class="fa-solid fa-trash-can"></i> Clear</button>
    </div>
  </div>
</header>

<main class="flex-1 max-w-7xl w-full mx-auto p-4 space-y-5">

  <!-- Loading -->
  <div id="loading" class="hidden panel p-4 text-sm font-mono text-blue-300 flex items-center gap-3"><i class="fa-solid fa-circle-notch fa-spin"></i> <span id="loading-text">Parsing telemetry…</span></div>

  <!-- Empty state -->
  <section id="empty-state" class="panel border-dashed border-2 p-10 text-center space-y-4 transition">
    <div class="mx-auto h-14 w-14 rounded-full bg-blue-500/10 border border-blue-500/30 flex items-center justify-center text-blue-400 text-2xl"><i class="fa-solid fa-flag-checkered"></i></div>
    <h2 class="font-display text-2xl font-bold text-white">Drop a Race Studio CSV to start the debrief</h2>
    <p class="text-sm text-slate-400 max-w-2xl mx-auto">Upload an AiM CSV export (one or several sessions) and, optionally, the track's <span class="font-mono text-purple-300">.amss</span> split file for sector timing. Everything is processed in your browser — nothing is uploaded anywhere.</p>
    <div class="flex flex-wrap justify-center gap-2 text-xs font-mono">
      <span class="card px-3 py-1.5 text-slate-300"><i class="fa-solid fa-file-csv text-emerald-400 mr-1"></i> Telemetry: AiM CSV (any channel set)</span>
      <span class="card px-3 py-1.5 text-slate-300"><i class="fa-solid fa-map-pin text-purple-400 mr-1"></i> Splits: .amss (RS3) or .asd</span>
      <span id="empty-track-status" class="card px-3 py-1.5 text-slate-500 hidden"></span>
    </div>
    <p class="text-[11px] text-slate-500 font-mono">Raw .drk / .xrk files can't be decoded in a browser — in Race Studio 3 right-click the session → Export → CSV.</p>
  </section>

  <section id="app" class="hidden space-y-5">
    <!-- Session strip -->
    <div class="panel p-3.5">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-3">
        <div class="min-w-0">
          <div class="text-xs font-semibold text-slate-200 flex items-center gap-2 flex-wrap">
            <span>File:</span><span id="strip-file" class="font-mono text-amber-300 break-all"></span>
            <span id="strip-tag" class="text-[10px] bg-blue-500/20 text-blue-300 border border-blue-500/30 px-1.5 py-0.5 rounded"></span>
          </div>
          <div id="strip-notes" class="text-[11px] text-slate-400 font-mono mt-0.5"></div>
        </div>
        <div id="strip-chips" class="flex flex-wrap items-center gap-2 text-xs font-mono"></div>
      </div>
      <div id="sessions-wrap" class="mt-3 hidden border-t border-racing-border pt-3">
        <div class="text-[10px] uppercase tracking-wider font-mono text-slate-500 mb-2">Loaded sessions — click to switch</div>
        <div id="sessions-list" class="flex flex-wrap gap-2"></div>
      </div>
    </div>

    <!-- Tabs -->
    <nav class="border-b border-racing-border flex items-center gap-2 overflow-x-auto pb-1" id="tabs">
      <button data-tab="snapshot" class="tab-btn active bg-racing-panelBg border border-racing-border text-slate-300 px-4 py-2 rounded-lg font-display text-sm font-semibold flex items-center gap-2 shrink-0"><i class="fa-solid fa-stopwatch text-emerald-400"></i> Laps & Sectors</button>
      <button data-tab="telemetry" class="tab-btn bg-racing-panelBg border border-racing-border text-slate-300 px-4 py-2 rounded-lg font-display text-sm font-semibold flex items-center gap-2 shrink-0"><i class="fa-solid fa-chart-line text-blue-400"></i> Lap Overlay & Delta</button>
      <button data-tab="coaching" class="tab-btn bg-racing-panelBg border border-racing-border text-slate-300 px-4 py-2 rounded-lg font-display text-sm font-semibold flex items-center gap-2 shrink-0"><i class="fa-solid fa-route text-amber-400"></i> Coaching & Map</button>
      <button data-tab="inputs" class="tab-btn bg-racing-panelBg border border-racing-border text-slate-300 px-4 py-2 rounded-lg font-display text-sm font-semibold flex items-center gap-2 shrink-0"><i class="fa-solid fa-gauge-high text-orange-400"></i> Driver Inputs</button>
      <button data-tab="shift" class="tab-btn bg-racing-panelBg border border-racing-border text-slate-300 px-4 py-2 rounded-lg font-display text-sm font-semibold flex items-center gap-2 shrink-0"><i class="fa-solid fa-gears text-purple-400"></i> Shifting</button>
      <button data-tab="setup" class="tab-btn bg-racing-panelBg border border-racing-border text-slate-300 px-4 py-2 rounded-lg font-display text-sm font-semibold flex items-center gap-2 shrink-0"><i class="fa-solid fa-sliders text-sky-400"></i> Setup, Notes & Weather</button>
      <button data-tab="mechanic" class="tab-btn bg-racing-panelBg border border-racing-border text-slate-300 px-4 py-2 rounded-lg font-display text-sm font-semibold flex items-center gap-2 shrink-0"><i class="fa-solid fa-wrench text-purple-400"></i> Engine & ECU Health</button>
      <button data-tab="audit" class="tab-btn bg-racing-panelBg border border-racing-border text-slate-300 px-4 py-2 rounded-lg font-display text-sm font-semibold flex items-center gap-2 shrink-0"><i class="fa-solid fa-list-check text-emerald-400"></i> Channel Audit (<span id="tab-ch-count">0</span>)</button>
    </nav>

    <!-- SNAPSHOT -->
    <div id="tab-snapshot" class="tab-content space-y-5">
      <div id="kpi-row" class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3"></div>
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-5">
        <div class="lg:col-span-2 space-y-5">
          <div class="panel p-4 space-y-3">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
              <div>
                <h3 class="font-display font-bold text-base text-white"><i class="fa-solid fa-list-ol text-emerald-400 mr-1"></i> LAP TIMING</h3>
                <p class="text-xs text-slate-400">Click a lap to compare it against your best in the overlay. Purple = session-best sector.</p>
              </div>
              <div class="flex items-center gap-2 text-[10px] font-mono">
                <span class="px-2 py-1 rounded bg-emerald-500/15 text-emerald-300 border border-emerald-500/30">FLYING ≤105%</span>
                <span class="px-2 py-1 rounded bg-amber-500/15 text-amber-300 border border-amber-500/30">SLOW / CAUTION</span>
              </div>
            </div>
            <div class="overflow-x-auto"><table class="w-full text-left border-collapse text-xs font-mono whitespace-nowrap" id="lap-table"></table></div>
          </div>
          <div class="panel p-4 space-y-2">
            <div class="flex items-center justify-between">
              <h3 class="font-display text-sm font-semibold text-slate-200"><i class="fa-solid fa-chart-bar text-blue-400 mr-1"></i> Flying-lap pace</h3>
              <span class="text-xs font-mono text-slate-400">Theoretical best: <span id="lbl-theo" class="text-purple-400">—</span></span>
            </div>
            <div class="chart-box h-56"><canvas id="chart-laps"></canvas></div>
          </div>
        </div>
        <div class="space-y-5">
          <div class="panel p-4 space-y-3">
            <h3 class="font-display font-bold text-sm text-white"><i class="fa-solid fa-crosshairs text-purple-400 mr-1"></i> SECTOR OPPORTUNITY</h3>
            <p class="text-[11px] text-slate-400">Average flying-lap time lost in each sector vs your best version of it.</p>
            <div id="sector-loss-wrap" class="chart-box h-64"><canvas id="chart-sector-loss"></canvas></div>
            <div id="sector-empty" class="hidden card p-3 text-xs text-slate-400 font-mono text-center">Load the track's .amss split file to unlock sector timing.</div>
            <div class="p-3 rounded-lg bg-purple-950/30 border border-purple-500/30 text-xs text-purple-300 font-mono flex items-center justify-between">
              <span><i class="fa-solid fa-wand-magic-sparkles"></i> Theoretical best</span>
              <span id="sum-theo" class="font-bold text-purple-300 text-sm">—</span>
            </div>
          </div>
          <div class="panel p-4 space-y-3">
            <h3 class="font-display font-bold text-sm text-white"><i class="fa-solid fa-user-check text-blue-400 mr-1"></i> SESSION HIGHLIGHTS</h3>
            <div id="highlights" class="space-y-2 text-xs font-mono"></div>
          </div>
        </div>
      </div>
    </div>

    <!-- TELEMETRY -->
    <div id="tab-telemetry" class="tab-content hidden space-y-4">
      <div class="panel p-4 space-y-3">
        <div class="flex flex-wrap items-center gap-2 text-xs font-mono">
          <span class="text-slate-400"><i class="fa-solid fa-code-compare text-blue-400"></i> Reference</span>
          <select id="sel-ref"></select>
          <button id="btn-swap" class="card px-2 py-1 hover:bg-slate-700" title="Swap"><i class="fa-solid fa-right-left"></i></button>
          <span class="text-slate-400">Compare</span>
          <select id="sel-cmp"></select>
          <span id="lbl-lapdelta" class="ml-2"></span>
          <span class="ml-auto text-slate-500">X-axis: lap distance (laps aligned by distance, not time)</span>
        </div>
        <div class="flex items-center gap-3">
          <span id="pos-readout" class="text-xs font-mono text-blue-300 w-64 shrink-0">—</span>
          <input id="scrubber" type="range" min="0" max="1000" value="0" class="w-full h-2 cursor-pointer">
        </div>
        <div id="gauges" class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-8 gap-2"></div>
      </div>
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
        <div class="lg:col-span-2 panel p-4 space-y-1">
          <div class="text-[11px] font-mono text-slate-400">SPEED (mph)</div><div class="chart-box h-48"><canvas id="ch-speed"></canvas></div>
          <div class="text-[11px] font-mono text-slate-400 pt-2">DELTA TIME (s) — above zero = compare lap is behind</div><div class="chart-box h-28"><canvas id="ch-delta"></canvas></div>
          <div class="text-[11px] font-mono text-slate-400 pt-2">THROTTLE % (amber) / BRAKE % of peak (red)</div><div class="chart-box h-36"><canvas id="ch-pedals"></canvas></div>
          <div class="text-[11px] font-mono text-slate-400 pt-2">RPM / GEAR</div><div class="chart-box h-32"><canvas id="ch-rpm"></canvas></div>
          <div class="text-[11px] font-mono text-slate-400 pt-2">STEERING (°) / LATERAL G</div><div class="chart-box h-32"><canvas id="ch-steer"></canvas></div>
        </div>
        <div class="space-y-4">
          <div class="panel p-3">
            <div class="flex items-center justify-between mb-2"><h3 class="font-display font-bold text-sm text-white"><i class="fa-solid fa-map text-emerald-400 mr-1"></i> TRACK</h3><span id="map-legend" class="text-[10px] font-mono text-slate-400"></span></div>
            <div class="relative bg-slate-950 rounded-lg overflow-hidden" style="height:300px"><canvas id="map-telemetry" style="width:100%;height:100%"></canvas></div>
          </div>
          <div class="panel p-3">
            <h3 class="font-display font-bold text-sm text-white mb-2"><i class="fa-solid fa-table text-purple-400 mr-1"></i> SECTOR DELTAS</h3>
            <div id="sector-compare" class="text-xs font-mono max-h-80 overflow-y-auto"></div>
          </div>
        </div>
      </div>
      <div class="panel p-4 space-y-2">
        <div class="flex flex-wrap items-center gap-2 text-xs font-mono">
          <h3 class="font-display font-bold text-sm text-white mr-2"><i class="fa-solid fa-magnifying-glass-chart text-teal-400 mr-1"></i> CHANNEL EXPLORER</h3>
          <select id="sel-explore"></select>
          <select id="sel-explore-mode"><option value="lap">Ref vs compare lap</option><option value="session">Whole session (time)</option></select>
          <span id="explore-note" class="text-slate-500"></span>
        </div>
        <div class="chart-box h-56"><canvas id="ch-explore"></canvas></div>
      </div>
    </div>

    <!-- COACHING -->
    <div id="tab-coaching" class="tab-content hidden space-y-5">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div>
          <h2 class="font-display font-bold text-2xl text-white">Data-Driven Coaching</h2>
          <p class="text-xs text-slate-400 font-mono mt-1">Every number below is computed from the uploaded laps — your fastest version of each sector vs your typical one.</p>
        </div>
        <span id="coach-badge" class="px-3 py-1.5 rounded-full bg-slate-800 border border-slate-700 text-xs text-slate-300 font-mono"></span>
      </div>
      <div class="panel p-4">
        <div class="flex items-center justify-between mb-2"><h3 class="font-display font-bold text-sm text-white"><i class="fa-solid fa-map text-emerald-400 mr-1"></i> BEST LAP — SPEED TRACE & SPLIT GATES</h3><span class="text-[10px] font-mono text-slate-400"><span style="color:#ef4444">■</span> slow · <span style="color:#f59e0b">■</span> mid · <span style="color:#10b981">■</span> fast · <span style="color:#c084fc">●</span> gate</span></div>
        <div class="relative bg-slate-950 rounded-lg overflow-hidden" style="height:380px"><canvas id="map-coach" style="width:100%;height:100%"></canvas></div>
      </div>
      <div id="coach-grid" class="grid grid-cols-1 lg:grid-cols-2 gap-5"></div>
    </div>

    <!-- INPUTS -->
    <div id="tab-inputs" class="tab-content hidden space-y-4">
      <div>
        <h2 class="font-display font-bold text-2xl text-white">Driver Input Analysis</h2>
        <p class="text-xs text-slate-400 font-mono mt-1">Flying laps only. Brake is shown as % of the session's peak so it works even if the sensor scaling is off.</p>
      </div>
      <div id="input-kpis" class="grid grid-cols-2 lg:grid-cols-5 gap-3"></div>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
        <div class="panel p-4 space-y-2"><h3 class="font-display font-bold text-sm text-white"><i class="fa-solid fa-chart-column text-amber-400 mr-1"></i> THROTTLE POSITION — TIME SPENT</h3><div class="chart-box h-48"><canvas id="ch-tps-hist"></canvas></div></div>
        <div class="panel p-4 space-y-2"><h3 class="font-display font-bold text-sm text-white"><i class="fa-solid fa-chart-column text-red-400 mr-1"></i> BRAKE APPLICATION — TIME SPENT (when braking)</h3><div class="chart-box h-48"><canvas id="ch-brake-hist"></canvas></div></div>
      </div>
      <div class="panel p-4 space-y-3">
        <h3 class="font-display font-bold text-sm text-white"><i class="fa-solid fa-list-check text-emerald-400 mr-1"></i> LAP-BY-LAP INPUTS</h3>
        <div class="overflow-x-auto"><table id="input-table" class="w-full text-left text-xs font-mono border-collapse whitespace-nowrap"></table></div>
      </div>
    </div>

    <!-- SHIFTING -->
    <div id="tab-shift" class="tab-content hidden space-y-4">
