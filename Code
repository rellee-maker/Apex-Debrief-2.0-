function renderCoaching(s) {
  const best = bestLap(s);
  if (s.hasGPS) drawMap($('map-coach'), s, best, { label: `Best lap — L${best.num} (${fmtLap(best.seconds)})${s.gates ? ` · ${s.gates.length} split gates` : ''}` });
  else { const c = $('map-coach'); const ctx = c.getContext('2d'); ctx.clearRect(0,0,c.width,c.height); }
  const { cards, flying } = coachCards(s);
  $('coach-grid').innerHTML = cards.map(c => c.html).join('');
  cards.forEach((c, i) => { if (c.action) { const b = $('coach-grid').children[i].querySelector('button'); if (b) b.onclick = c.action; } });
  $('coach-badge').innerText = `${cards.length} insights from ${flying.length} flying laps`;
}
function coachCards(s) {
  const best = bestLap(s);
  const flying = s.laps.filter(l => l.type === 'flying');
  const cards = [];
  if (flying.length < 2) return { flying, cards: [card('amber', 'Not enough flying laps', '—', 'Need at least two laps within 105% of the best to compare.', 'Run a longer session or check lap detection (Beacon Markers).', 'LOW', 'Lap timing')] };

  // Sector opportunities
  if (s.sectorCount) {
    const opps = [];
    for (let i = 0; i < s.sectorCount; i++) {
      const laps = flying.filter(l => isNum(l.sectors[i])); if (laps.length < 2) continue;
      const fastest = laps.reduce((a, b) => a.sectors[i] < b.sectors[i] ? a : b);
      const avg = laps.reduce((a, l) => a + l.sectors[i], 0) / laps.length;
      opps.push({ i, fastest, avg, loss: avg - fastest.sectors[i], others: laps.filter(l => l !== fastest) });
    }
    opps.sort((a, b) => b.loss - a.loss);
    opps.slice(0, 4).forEach((o, rank) => {
      const fm = sectorMetrics(s, o.fastest, o.i);
      const om = o.others.map(l => sectorMetrics(s, l, o.i)).filter(Boolean);
      const mean = k => { const v = om.map(m => m[k]).filter(isNum); return v.length ? v.reduce((a,b)=>a+b,0)/v.length : NaN; };
      const f = [], rec = [];
      const dMin = fm.min - mean('min'), dBrake = fm.brakeD - mean('brakeD'), dExit = fm.exit - mean('exit'), dEntry = fm.entry - mean('entry'), dTps = fm.fullPct - mean('fullPct'), dCoast = fm.coastS - mean('coastS');
      if (isNum(dEntry) && Math.abs(dEntry) >= 1) f.push(`entry speed ${fmtDelta(dEntry,1)} mph`);
      if (isNum(dBrake) && Math.abs(dBrake) >= 3) f.push(`braked ${Math.abs(dBrake).toFixed(0)} m ${dBrake > 0 ? 'later' : 'earlier'}`);
      if (isNum(dMin) && Math.abs(dMin) >= 0.8) f.push(`minimum speed ${fmtDelta(dMin,1)} mph (${fm.min.toFixed(1)} vs ${mean('min').toFixed(1)})`);
      if (isNum(dExit) && Math.abs(dExit) >= 1) f.push(`exit speed ${fmtDelta(dExit,1)} mph`);
      if (isNum(dTps) && Math.abs(dTps) >= 4) f.push(`full throttle ${fmtDelta(dTps,0)} pts of the sector`);
      if (isNum(dCoast) && Math.abs(dCoast) >= 0.15) f.push(`coasting ${fmtDelta(dCoast,2)}s`);
      if (dMin >= 0.8) rec.push(`Carry more speed through the middle — the fast version rolled ${dMin.toFixed(1)} mph quicker at the slowest point (~${Math.round(fm.minD)} m into the sector).`);
      if (dBrake >= 3) rec.push(`Brake later: on L${o.fastest.num} you held off ${dBrake.toFixed(0)} m longer before reaching 25% brake.`);
      else if (dBrake <= -3 && dMin > 0) rec.push(`The fast version actually braked ${Math.abs(dBrake).toFixed(0)} m earlier — slow-in/fast-out paid off here; don't over-drive the entry.`);
      if (dExit >= 1) rec.push(`Prioritise the exit — ${dExit.toFixed(1)} mph more at the end of the sector carries down the next straight.`);
      if (dCoast <= -0.15) rec.push(`Cut the coasting: ${Math.abs(dCoast).toFixed(2)}s less time off both pedals on the fast lap.`);
      if (!rec.length) rec.push(`No single input explains it — overlay L${o.fastest.num} vs a typical lap in the Lap Overlay tab and look at line/steering.`);
      const startG = o.i === 0 ? 'S/F' : `gate ${o.i}`, endG = o.i === s.sectorCount-1 ? 'S/F' : `gate ${o.i+1}`;
      cards.push(card(rank === 0 ? 'red' : rank < 2 ? 'amber' : 'blue', `S${o.i+1} (${startG} → ${endG})`, `avg ${fmtDelta(o.loss)}s/lap`,
        `Your best S${o.i+1} was ${o.fastest.sectors[o.i].toFixed(3)}s on L${o.fastest.num}; flying-lap average ${o.avg.toFixed(3)}s across ${o.others.length+1} laps. Fast version vs average: ${f.join(', ') || 'similar inputs'}.`,
        rec.join(' '), o.others.length >= 4 ? 'HIGH' : 'MEDIUM', `Gate-crossing sector times + speed/brake/TPS`, rank + 1,
        () => { S.ref = o.fastest.num; S.cmp = o.others.slice().sort((a,b)=>a.sectors[o.i]-b.sectors[o.i])[Math.floor(o.others.length/2)].num; S.cursorD = o.fastest.bounds[o.i].d; switchTab('telemetry'); }));
    });
  }

  // Consistency
  const avg = flying.reduce((a,l)=>a+l.seconds,0)/flying.length, sd = Math.sqrt(flying.reduce((a,l)=>a+(l.seconds-avg)**2,0)/flying.length);
  cards.push(card(sd < 0.4 ? 'emerald' : sd < 1 ? 'amber' : 'red', 'Lap-to-lap consistency', `σ ±${sd.toFixed(3)}s`,
    `${flying.length} flying laps, best ${fmtLap(best.seconds)}, average ${fmtLap(avg)} (${fmtDelta(avg - best.seconds)}s).${isNum(s.theo) ? ` Theoretical best ${fmtLap(s.theo)}.` : ''}`,
    sd < 0.4 ? 'Consistency is strong — the remaining time is in individual sectors (see the cards above).' : 'Variation is costing more than any single corner. Pick reference points (braking boards, turn-in markers) for the top sectors and repeat them every lap.',
    'HIGH', 'Beacon lap times'));

  // Throttle / coasting
  const tps = chData(s,'tps'), bp = s.brakePct, spd = chData(s,'speed') || chData(s,'wspeed');
  if (tps) {
    let full = 0, coast = 0, n = 0, dt = 1/s.hz;
    flying.forEach(l => { for (let i = l.iStart; i <= l.iEnd; i++) { n++; if (tps[i] >= 90) full++; if (tps[i] < 5 && (!bp || bp[i] < 5) && spd && spd[i] > 20) coast++; } });
