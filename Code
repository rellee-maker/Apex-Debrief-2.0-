}
function renderMechanic(s) {
  const BADGE = { ok: ['NORMAL','bg-emerald-500/10 border-emerald-500/30 text-emerald-300'], amber: ['WATCH','bg-amber-500/10 border-amber-500/30 text-amber-300'], red: ['ATTENTION','bg-red-500/10 border-red-500/30 text-red-300'], scale: ['CHECK SCALING','bg-slate-700/50 border-slate-500 text-slate-300'], dead: ['NO SIGNAL','bg-slate-800 border-slate-700 text-slate-500'] };
  const evals = mechEvals(s);
  $('mech-summary').innerText = `${evals.length} systems · ${evals.filter(e => e.state === 'ok').length} normal · ${evals.filter(e => e.state === 'amber' || e.state === 'red').length} flagged · ${evals.filter(e => e.state === 'scale').length} need calibration`;
  $('mech-cards').innerHTML = evals.slice(0, 8).map(e => `<div class="card p-3 flex justify-between items-start gap-2"><div><div class="text-[10px] text-slate-400 font-mono">${esc(e.m.label.toUpperCase())}</div><div class="font-bold text-lg font-mono ${e.state === 'red' ? 'text-red-400' : e.state === 'amber' ? 'text-amber-400' : e.state === 'ok' ? 'text-emerald-400' : 'text-slate-400'}">${fmtNum(e.v, e.m.unit === 'λ' ? 3 : 1)} <span class="text-xs text-slate-500">${e.m.unit}</span></div><div class="text-[10px] text-slate-500 font-mono">${esc(e.ch.name)}</div></div><span class="text-[9px] px-1.5 py-0.5 rounded border font-mono ${BADGE[e.state][1]}">${BADGE[e.state][0]}</span></div>`).join('');
  $('mech-table').innerHTML = evals.map(e => { const st = e.ch.stats; return `<div class="grid grid-cols-[1fr_auto_auto] gap-3 px-4 py-2.5 items-center"><div><div class="text-slate-200 font-semibold">${esc(e.m.label)}</div><div class="text-[10px] text-slate-500">${esc(e.ch.name)} · min ${fmtNum(st.min)} / avg ${fmtNum(st.avg)} / max ${fmtNum(st.max)} ${esc(e.ch.unit)}</div></div><div class="text-slate-100 font-bold">${fmtNum(e.v, e.m.unit === 'λ' ? 3 : 1)} ${e.m.unit}</div><span class="text-[10px] px-2 py-1 rounded border ${BADGE[e.state][1]}">${BADGE[e.state][0]}</span></div>`; }).join('') || '<div class="p-4 text-slate-500">No engine/electrical channels recognised in this export.</div>';

  // Notes
