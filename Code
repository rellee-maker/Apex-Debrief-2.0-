    if (m.agg === 'wot' && !(tps && tps[i] > 90 && rpm && rpm[i] > 3500)) continue;
    const v = d[i]; if (!isNum(v)) continue;
    if (v < mn) mn = v; if (v > mx) mx = v; sum += v; n++;
